#!/bin/sh
# qm1-bluetooth-up -- make sure the Bluetooth controller shows up, and say so
# loudly when it does not.
#
# The controller is the BT half of the Realtek RTL8723BS combo chip, exposed
# by the firmware as an ACPI UART (HID OBDA8723 / OBDA0623).  The kernel
# driver hci_uart (with the 3WIRE protocol built in) binds it, and btrtl
# pushes the vendor firmware (rtl_bt/rtl8723bs_fw.bin plus
# rtl_bt/rtl8723bs_config-OBDA8723.bin).
#
# A missing hci0 is NOT a boot-blocking failure: bluez would only report
# "no adapter", and the rest of the machine has to come up.  But it must not
# be silent either -- an invisible failure looks like "the Bluetooth function
# is missing" and nobody knows where to look.  So we leave a marker file and
# a journal entry with the likely cause.
#
# 只在固件暴露匹配 HID 时尝试晚期加载；模块本身注册 H5 serdev
# 驱动，不会自行接管所有 8250 端口。UART 父控制器与蓝牙子设备必须
# 分别检查；父控制器绑定串口驱动是正常枚举路径的一部分。

set -u

# ★ 失败证据要能活过重启。
#   原来只写 /run（tmpfs）⇒ 机器一重启，唯一的线索就没了 —— 而蓝牙这件事
#   恰恰是"要现场复现才看得见"的问题。现在把内容写进 /var/lib/qm1/，
#   /run 下留一个指向它的软链，老路径照旧能读。
MARKER_PERSIST=/var/lib/qm1/bluetooth-failed
MARKER=/run/qm1-bluetooth.failed
LOG_TAG=qm1-bluetooth

log() { logger -t "$LOG_TAG" -- "$*" 2>/dev/null || true; printf '%s\n' "$*" >&2 || true; }

mkdir -p /var/lib/qm1 2>/dev/null || true
rm -f "$MARKER"

# 这台机有没有暴露蓝牙的 ACPI HID？
acpi_owner=""
acpi_hid=""
for dev in /sys/bus/acpi/devices/*; do
    [ -e "$dev" ] || continue
    hid="$(cat "$dev/hid" 2>/dev/null || true)"
    case "$(printf '%s' "$hid" | tr 'a-z' 'A-Z')" in
        OBDA8723|OBDA0623)
            acpi_hid="$hid"
            acpi_owner="$(basename "$(readlink -f "$dev/physical_node/driver" 2>/dev/null || readlink -f "$dev/driver" 2>/dev/null || echo none)")"
            ;;
    esac
done

write_marker() {
    {
        echo "time=$(date -u +%FT%TZ)"
        echo "acpi_hid=${acpi_hid:-none}"
        echo "acpi_owner=${acpi_owner:-none}"
        echo "firmware=$( [ -f /lib/firmware/rtl_bt/rtl8723bs_fw.bin ] && echo present || echo missing )"
        echo "serdev_driver=$( [ -d /sys/bus/serial/drivers/hci_uart_h5 ] && echo registered || echo absent )"
        echo "hint=$1"
    } >"$MARKER_PERSIST"
    chmod 0644 "$MARKER_PERSIST" 2>/dev/null || true
    ln -sf "$MARKER_PERSIST" "$MARKER" 2>/dev/null || true
}

if [ -z "$acpi_hid" ] && [ ! -e /etc/qm1/bluetooth-force ]; then
    # 此处只表示没有发现这两个匹配 HID，不能据此断言硬件不存在。
    # 早期 modules-load 和此晚期守卫都不应靠禁用 UART 父驱动来排障。
    # bluetooth-force 只允许尝试模块加载，不改变 ACPI 描述或设备绑定。
    log "这台机没有暴露蓝牙的 ACPI HID（OBDA8723/OBDA0623）⇒ hci_uart 没有可绑定的串口，不加载它"
    write_marker "no Bluetooth ACPI HID (OBDA8723/OBDA0623) on this machine; hci_uart was not loaded on purpose"
    exit 0
fi

modprobe hci_uart 2>/dev/null || true
modprobe btrtl 2>/dev/null || true

i=0
while [ "$i" -lt 30 ]; do
    if [ -d /sys/class/bluetooth/hci0 ]; then
        rm -f "$MARKER_PERSIST" "$MARKER"
        log "hci0 is up"
        exit 0
    fi
    i=$((i + 1))
    sleep 1
done

# No hci0: record the observation without guessing a board-specific remedy.
write_marker "inspect UART parent and Bluetooth serdev child bindings, probe/dependency errors and firmware logs; do not blacklist a UART controller solely because hci0 is absent"

log "no hci0 after 30s; ACPI owner=${acpi_owner:-none} (details in $MARKER)"
exit 0
