#!/bin/bash
# qm1-install-to-emmc — 分步引导式安装：把当前系统装进目标存储
#
# 触发方式：安装介质 GRUB 菜单第 ① 项（内核参数 qm1.install=1 qm1.install.mode=emmc
#           qm1.install.yes=1）→ systemd 单元 qm1-install.service → 本脚本。
#
# 设计目标（来自实际使用场景）：
#   1) **默认目标是 eMMC**：QM1 是"装进去、开机就能用"的机器，不是插盘运行的
#      临时盘 —— GRUB 菜单 ① 明确带 qm1.install.mode=emmc。
#      非破坏性路径（装到 U 盘 / microSD，eMMC 一个字节都不动、原系统保留、
#      拔卡即可回退）仍然保留，但必须显式 --mode media，不会被自动选中。
#   2) **覆盖 eMMC 前强制整盘备份**：备份放不下就中止，不"先写后说"。
#      备份位置自动挑：--backup-dir → 安装介质上空间足够的挂载点 →
#      安装介质尾部未分区的空间（U 盘容量大于安装镜像时的"同盘既当启动盘
#      又当备份盘"）。备份做**逐分区 sha256 比对**，不是只算文件自身的哈希。
#   3) **一次性配好 Wi-Fi 与 SSH**：装机时就把 SSID/密码写进系统，并把 SSH 开好，
#      装完拔盘重启就能联网、能远程登录，不用再接显示器键盘手动敲配置。
#      provisioning 文件（照 Raspberry Pi 的做法放在启动分区）也能直接生效。
#      同时给镜像内置的 qm1 账号生成一次性口令并打印出来 —— 镜像里不放默认口令。
#   4) **写盘必须可核对**：写完立刻逐分区 sha256 比对，不一致立刻中止，
#      不带着一个写坏的目标继续做后面的步骤。
#   5) **写完要能被固件找到**：用 efibootmgr 在 UEFI 里登记一条指向目标 ESP 的
#      启动项，否则装完可能要靠 BIOS 菜单手动选启动设备。
#   6) **一步一步**：每个步骤都打印当前做什么、做完是什么结果，可随时 Ctrl-C。
#
# 步骤：
#   [1/6] 选择安装目标（默认 eMMC；可移动介质需显式 --mode media）
#   [2/6] 检查目标（是否已有分区、是不是源盘）
#   [3/6] 网络与 SSH 配置（读 provisioning 或交互输入；写进 live 系统 +
#         给 qm1 账号生成一次性口令，口令会随整盘复制进目标）
#   [4/6] 备份（写 eMMC 时强制整盘备份 + 逐分区校验，空间不够就中止）
#   [5/6] 写入系统（GPT + dd + 逐分区校验 + 撑满整盘 + 登记 UEFI 启动项）
#   [6/6] 收尾（写回 provisioning、安装记录、下一步提示）
#
# 内核命令行参数（GRUB 菜单用）：
#   qm1.install=1              触发本脚本
#   qm1.install.mode=emmc       安装模式（emmc | media）
#   qm1.install.yes=1           非交互模式下也确认破坏性操作
#   qm1.install.target=/dev/xxx 指定目标设备
set -eu
# pipefail 不是 POSIX 选项，但这个脚本实际由 bash 执行（/bin/bash），
# 带上它才能发现"管道里前一段失败、后一段成功"这种静默错误。
# 用子 shell 试一次：不是 bash 就跳过，不影响其余逻辑。
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

warn() { printf '[qm1-install][warn] %s\n' "$*" >&2; }
die()  { printf '[qm1-install][fail] %s\n' "$*" >&2; exit 1; }
# ★ 所有输出都走 stderr（stdout 留给将来的机器可读输出）。
#   原因：stdout 重定向到文件时是块缓冲的，stderr 是无缓冲的 —— 两者混在
#   同一个文件里时顺序会错乱（stderr 先落盘、stdout 到退出时才刷出来），
#   排障时看到的"最后一行"根本不是最后发生的事。统一走 stderr 之后，
#   日志顺序 = 真实顺序。
log()  { printf '[qm1-install] %s\n' "$*" >&2; }
step() { printf '\n[qm1-install] ===== %s =====\n' "$*" >&2; }

# ★ 静默退出是排查噩梦：set -e 遇到一条失败命令就直接退出，日志上只留下
#   "上一条正常输出"，看着像"到这一步就没了"，根本猜不出是哪条命令、
#   在哪一行失败。这里挂一个 ERR 钩子，把行号和退出码打出来。
#   （真机上用户只能看到串口日志，这一行就是唯一的线索。）
#   set -E 让 ERR 钩子在函数与子 shell 里同样生效。
# shellcheck disable=SC3041  # POSIX sh 没有 -E；本脚本由 bash 执行
set -E
# _qm1_rc 先给个初值：shellcheck 看不穿 trap 里的赋值，会把下面那次引用
# 报成 SC2154（"引用了未赋值的变量"）。
_qm1_rc=0
# shellcheck disable=SC3047  # POSIX sh 没有 ERR trap；本脚本由 bash 执行
trap '_qm1_rc=$?; printf "[qm1-install][fail] 第 %s 行命令失败（退出码 %s）—— 上面的日志停在它前面那条\n" "$LINENO" "$_qm1_rc" >&2; exit "$_qm1_rc"' ERR

ask() {
    # ask <提示> <默认值> → 结果写到 REPLY
    # POSIX sh 没有 local，这里用带前缀的全局变量代替，
    # 避免和调用方的同名变量串味。
    _ask_prompt="$1"
    _ask_default="${2:-}"
    if [ ! -t 0 ]; then
        # 非交互（systemd 单元 / 无人值守）：不能像原来那样默默用默认值。
        #
        # 原来的写法在这里返回默认值，而"确认覆盖？"的默认值是 no
        # ⇒ 从 GRUB 菜单选 ①（非 TTY）时，安装器在 [2/6] 就 die 退出，
        # "安装到 eMMC" 变成一个永远走不完的空操作。
        #
        # 现在：破坏性确认只在 --yes / qm1.install.yes=1 时自动通过，
        # 否则明确报错并告诉人怎么继续（而不是无声退出）。
        if [ "$ASSUME_YES" = "1" ]; then
            REPLY="yes"
        else
            REPLY="no"
        fi
        log "非交互模式：$_ask_prompt → ${REPLY}（要自动确认请加 --yes 或内核参数 qm1.install.yes=1）"
        return 0
    fi
    if [ -n "$_ask_default" ]; then
        printf '%s [%s]: ' "$_ask_prompt" "$_ask_default"
    else
        printf '%s: ' "$_ask_prompt"
    fi
    read -r REPLY || REPLY=""
    [ -n "$REPLY" ] || REPLY="$_ask_default"
}

[ "$(id -u)" -eq 0 ] || die "需要 root 权限"

# 磁盘层面的判断与 wpa_supplicant 的取值规则都在这个库里：
# 那是"哪些字节写到哪里"和"密码怎么写进配置"的逻辑，写错就是一块报废的 eMMC
# 或者一台连不上网的机器。单独成文件是为了能在 CI 里用合成的 GPT 镜像直接验证
# 它，而不必真机。
#
# 库文件的位置允许覆盖（QM1_INSTALL_LIB / --lib）：设备上装的是
# /usr/local/lib/qm1/install-lib.sh，而 CI 里直接用仓库里那一份 ——
# 这样"构建链的实现"和"镜像里的实现"能在同一台机器上被同一套用例验证。
QM1_INSTALL_LIB="${QM1_INSTALL_LIB:-/usr/local/lib/qm1/install-lib.sh}"

TARGET="${QM1_INSTALL_TARGET:-}"
MODE="${QM1_INSTALL_MODE:-auto}"          # auto | media | emmc
ASSUME_YES="${QM1_ASSUME_YES:-0}"
BACKUP_DIR="${QM1_BACKUP_DIR:-}"
PROVISION_DIR="${QM1_PROVISION_DIR:-}"
SSID="${QM1_SSID:-}"
PSK="${QM1_PSK:-}"
ENABLE_SSH="${QM1_ENABLE_SSH:-auto}"      # auto | yes | no
SSH_USER="${QM1_SSH_USER:-}"
SSH_PUBKEY="${QM1_SSH_PUBKEY:-}"
SSH_PASSWORD="${QM1_SSH_PASSWORD:-}"
HOSTNAME_CFG="${QM1_HOSTNAME:-}"
LOGIN_USER="qm1"
# 源（要复制出去的那套系统）。默认从 / 的挂载点反查；允许显式指定 ——
# CI 里没有"从 U 盘启动的 QM1"，只有合成出来的 GPT 循环设备，
# 源必须能由参数给定，否则整套写盘流程没法在 CI 上跑。
SRC_ROOT_OVERRIDE="${QM1_SOURCE_ROOT:-}"
SRC_ESP_OVERRIDE="${QM1_SOURCE_ESP:-}"
SRC_DISK_OVERRIDE="${QM1_SOURCE_DISK:-}"
# CI / 无交互验证时跳过登录账号与口令设置（改的是构建机的账号，不该碰）
NO_LOGIN_ACCOUNT="${QM1_NO_LOGIN_ACCOUNT:-0}"
# 显式跳过 EFI 启动项登记。只在"确实没法登记"时才用 ——
# 悄悄跳过却报成功是最坏的结果（机器开不了机，报告却说装好了）。
SKIP_EFI_ENTRY="${QM1_SKIP_EFI_ENTRY:-0}"
# 显式覆盖目标介质的类型（emmc/sd/other）。空 = 按内核报的类型认。
# ★ 必须在这里给初值：脚本开了 set -u，不给初值的话，
#   "没传 --force-kind" 这条最常见的路径会直接因 unbound variable 退出。
FORCE_KIND=""
# efivars 的位置。默认就是内核给的那个；做成可注入的，是为了让端到端测试
# 能走到"这台机器压根没在 UEFI 模式下启动"那条分支 ——
# CI 的 runner 恰恰**有** efivars（还预装了 efibootmgr），
# 想测"没有 efivars"时那条最终状态说清楚了没有，就得能把它指到一个
# 不存在的路径上去。
EFIVARS_PATH="${QM1_EFIVARS_PATH:-/sys/firmware/efi/efivars}"

while [ $# -gt 0 ]; do
    case "$1" in
        --target) TARGET="$2"; shift 2 ;;
        --mode) MODE="$2"; shift 2 ;;
        --provision-dir) PROVISION_DIR="$2"; shift 2 ;;
        --ssid) SSID="$2"; shift 2 ;;
        --psk) PSK="$2"; shift 2 ;;
        --enable-ssh) ENABLE_SSH=yes; shift ;;
        --no-ssh) ENABLE_SSH=no; shift ;;
        --ssh-user) SSH_USER="$2"; shift 2 ;;
        --ssh-pubkey) SSH_PUBKEY="$2"; shift 2 ;;
        --ssh-password) SSH_PASSWORD="$2"; shift 2 ;;
        --hostname) HOSTNAME_CFG="$2"; shift 2 ;;
        --backup-dir) BACKUP_DIR="$2"; shift 2 ;;
        --force-kind) FORCE_KIND="$2"; shift 2 ;;
        --lib) QM1_INSTALL_LIB="$2"; shift 2 ;;
        --source-root) SRC_ROOT_OVERRIDE="$2"; shift 2 ;;
        --source-esp) SRC_ESP_OVERRIDE="$2"; shift 2 ;;
        --source-disk) SRC_DISK_OVERRIDE="$2"; shift 2 ;;
        --no-login-account) NO_LOGIN_ACCOUNT=1; shift ;;
        --skip-efi-entry) SKIP_EFI_ENTRY=1; shift ;;
        --yes) ASSUME_YES=1; shift ;;
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "未知参数：$1" ;;
    esac
done

if [ -r "$QM1_INSTALL_LIB" ]; then
    # shellcheck source=/dev/null
    . "$QM1_INSTALL_LIB"
else
    printf '[qm1-install][fail] 缺少 %s，无法继续\n' "$QM1_INSTALL_LIB" >&2
    exit 1
fi

# ---------- 内核命令行参数 ----------
# GRUB 菜单靠内核参数把"装到哪、要不要确认"告诉本脚本（单元是
# ConditionKernelCommandLine=qm1.install=1 触发的，没有别的传参通道）：
#   qm1.install.mode=emmc|media
#   qm1.install.yes=1
#   qm1.install.target=/dev/mmcblk1
#   qm1.install.backup_dir=<目录>
#
# ★ qm1.install.backup_dir 是给"备份放哪"补的通道。
#   覆盖 eMMC 之前必须有一份能放下整盘（28.5GiB）的备份，而菜单①所在的
#   安装介质自己那点空间根本放不下 —— 没有这个参数，现场就只能手动敲命令
#   跑安装器（GRUB 里按 c / e 编辑命令行），门槛太高。
#   路径里不能有空格（内核参数按空格切分），所以只能给无空格的路径。
for _w in $(cat /proc/cmdline 2>/dev/null || true); do
    case "$_w" in
        qm1.install.mode=*)   MODE="${_w#qm1.install.mode=}" ;;
        qm1.install.yes=1)    ASSUME_YES=1 ;;
        qm1.install.target=*) TARGET="${_w#qm1.install.target=}" ;;
        qm1.install.backup_dir=*)
            BACKUP_DIR="${_w#qm1.install.backup_dir=}"
            ;;
    esac
done
# 优先级：命令行 > 环境变量（QM1_INSTALL_MODE / QM1_INSTALL_TARGET 等在上面的
# 变量初始化里已经读过；这里内核命令行在后面覆盖它）。
log "安装模式：${MODE}　目标：${TARGET:-自动选择}　自动确认：$ASSUME_YES"

for c in findmnt lsblk sfdisk dd sha256sum e2fsck resize2fs mount blockdev; do
    command -v "$c" >/dev/null 2>&1 || die "缺少命令 ${c}（镜像里应装有 util-linux / fdisk / e2fsprogs）"
done

# ---------- 源：当前系统所在的整盘 ----------
#
# 默认从 / 的挂载点反查；也可以显式指定（--source-root / --source-esp /
# --source-disk 或环境变量 QM1_SOURCE_*）。CI 里没有"从 U 盘启动的 QM1"，
# 只有合成出来的 GPT 循环设备 —— 源必须能由参数给定，否则整套写盘流程
# 只能在真机上验证，写盘逻辑的回归就没人守了。
SRC_ROOT="$SRC_ROOT_OVERRIDE"
if [ -z "$SRC_ROOT" ]; then
    SRC_ROOT="$(findmnt -no SOURCE / 2>/dev/null || true)"
fi
[ -n "$SRC_ROOT" ] || die "找不到当前根文件系统挂载点"
SRC_PART="${SRC_ROOT#/dev/}"
if [ -n "$SRC_DISK_OVERRIDE" ]; then
    SRC_DISK="$SRC_DISK_OVERRIDE"
else
    SRC_PK="$(lsblk -no PKNAME "/dev/$SRC_PART" 2>/dev/null | head -1 || true)"
    [ -n "$SRC_PK" ] || die "无法定位源分区所属磁盘（当前根在 ${SRC_ROOT}）"
    SRC_DISK="/dev/$SRC_PK"
fi

log "当前系统根分区：${SRC_ROOT}（磁盘 ${SRC_DISK}）"

SRC_ESP="$SRC_ESP_OVERRIDE"
if [ -z "$SRC_ESP" ]; then
    for p in $(lsblk -no NAME "$SRC_DISK" 2>/dev/null | grep -v '^$' || true); do
        [ "$p" = "$(basename "$SRC_PART")" ] && continue
        # ★ 不要写 `lsblk ... | grep -qi vfat`：管道里 grep 一命中就退，
        #   上游 lsblk 还在写就被 SIGPIPE 打死（141），而本脚本开了
        #   pipefail ⇒ "找到了"会被误判成"没找到"。先取值再判断。
        _p_fs="$(lsblk -no FSTYPE "/dev/$p" 2>/dev/null || true)"
        case "$_p_fs" in
            *[Vv][Ff][Aa][Tt])
                SRC_ESP="/dev/$p"
                break
                ;;
        esac
    done
fi
[ -n "$SRC_ESP" ] || die "在 $SRC_DISK 上找不到 FAT32 的 ESP 分区"
# 源必须都是块设备：dd 复制的是**整个设备**（含文件系统之外的空闲区），
# 尺寸也按设备算。用 stat 读块设备节点只会得到 0。
[ -b "$SRC_ESP" ]  || die "源 ESP 不是块设备：$SRC_ESP"
[ -b "$SRC_ROOT" ] || die "源根分区不是块设备：${SRC_ROOT}（整分区复制需要块设备）"
log "源 ESP：$SRC_ESP   源根分区：$SRC_ROOT"

# ---------- [1/6] 选择安装目标 ----------
step "[1/6] 选择安装目标"

device_kind() {
    # 输出 removable / usb / emmc / sd / sdio / mmc-unknown / other
    #
    # 关键：**不能把所有 mmcblk* 都当成 eMMC**。
    # QM1 上 Wi-Fi（Realtek RTL8723BS，SDIO）占着 mmc0，eMMC 实际是 mmc1
    # （实机观测 mmc1 = ACPI 80860F14:00 = SanDisk S10032 28.5 GiB）。
    # 把 mmcblk0 当 eMMC ⇒ 找不到真正的 eMMC；而一旦 ACPI 没认出 eMMC、
    # 兜底按字典序选第一个 mmcblk，选中的就是那张 **Wi-Fi 卡** ——
    # 往上面写整盘镜像，等于把主联网链路写坏。
    #
    # 内核在 MMC 卡的 device/type 里给出真实类型：
    #   MMC = eMMC，SD = SD 卡，SDIO = SDIO 卡（本机的 Wi-Fi）
    _dk_name="$1"
    _dk_d="/sys/block/$1"
    _dk_dev=""
    _dk_type=""
    _dk_dev="$(readlink -f "$_dk_d/device" 2>/dev/null || true)"
    if [ -n "$_dk_dev" ] && [ -r "$_dk_dev/type" ]; then
        _dk_type="$(cat "$_dk_dev/type" 2>/dev/null || true)"
    fi
    case "$_dk_type" in
        MMC)   echo "emmc"; return ;;
        SD)    echo "sd"; return ;;
        SDIO*) echo "sdio"; return ;;
    esac
    if [ "$(cat "$_dk_d/removable" 2>/dev/null || echo 0)" = "1" ]; then echo "removable"; return; fi
    # 同上：不用管道 + grep -q（SIGPIPE 会让 pipefail 把"是"判成"不是"）。
    case "$_dk_dev" in
        */usb*) echo "usb"; return ;;
    esac
    # 是 MMC 设备但读不到 type（老内核 / 没暴露）：不猜，交给调用方显式指定
    case "$_dk_name" in
        mmcblk*) echo "mmc-unknown"; return ;;
    esac
    echo "other"
}

list_candidates() {
    _lc_d=""; _lc_name=""; _lc_dev=""; _lc_kind=""; _lc_size=""
    for _lc_d in /sys/block/*; do
        _lc_name="$(basename "$_lc_d")"
        case "$_lc_name" in loop*|ram*|sr*|dm-*|zram*|md*|nbd*) continue ;; esac
        _lc_dev="/dev/$_lc_name"
        [ -b "$_lc_dev" ] || continue
        [ "$_lc_dev" = "$SRC_DISK" ] && continue
        _lc_kind="$(device_kind "$_lc_name")"
        # SDIO 卡（本机的 Wi-Fi 模块）永远不作为安装目标：
        # 往它上面写分区表会直接毁掉主联网链路。
        if [ "$_lc_kind" = "sdio" ]; then
            printf '  %-16s %-10s %s\n' "$_lc_dev" "sdio" "$(lsblk -dno SIZE "$_lc_dev" 2>/dev/null | head -1 || true)（跳过：Wi-Fi 的 SDIO 卡）"
            continue
        fi
        _lc_size="$(lsblk -dno SIZE "$_lc_dev" 2>/dev/null | head -1 || true)"
        printf '  %-16s %-10s %s\n' "$_lc_dev" "$_lc_kind" "$_lc_size"
    done
}

CANDIDATES="$(list_candidates)"
if [ -z "$CANDIDATES" ]; then
    log "没有发现除当前系统盘之外的候选设备"
    CANDIDATES=""
else
    log "候选设备（设备 / 类型 / 容量）："
    printf '%s\n' "$CANDIDATES"
fi

if [ -z "$TARGET" ]; then
    # 自动选目标。分两种情况，**不能混**：
    #   mode=emmc/auto → 只认内核 MMC 类型 = MMC 的设备（真 eMMC）
    #   mode=media     → 只认可移动 / USB 介质，绝不碰 eMMC
    #
    # 原来这里写死 /dev/mmcblk0 —— 在 QM1 上那是 Wi-Fi 的 SDIO 卡；
    # 而且按字典序兜底选第一个 mmcblk，选中的同样是那张 Wi-Fi 卡。
    # 往上面写整盘镜像 = 把主联网链路写坏。
    AUTO_TARGET=""
    if [ "$MODE" = "media" ]; then
        # 用 awk 选，而不是 while read <<< ：管道里的 read 在子 shell 中执行，
        # 循环里赋的变量出不来（POSIX sh 没有 here-string 可用）。
        AUTO_TARGET="$(printf '%s\n' "$CANDIDATES" | awk '$2=="removable"||$2=="usb"{print $1; exit}')"
        [ -n "$AUTO_TARGET" ] || die "--mode media 需要一个可移动 / USB 介质作为目标，但没找到。
本机候选设备如下：
$(printf '%s\n' "$CANDIDATES" | sed 's/^/    /')
请用 --target <设备> 显式指定（例如 --target /dev/sdb）。"
        TARGET="$AUTO_TARGET"
        log "选中可移动介质：${TARGET}（eMMC 不会被触碰）"
    else
        AUTO_TARGET="$(printf '%s\n' "$CANDIDATES" | awk '$2=="emmc"{print $1; exit}')"
        [ -n "$AUTO_TARGET" ] || die "没有找到 eMMC（内核 MMC 类型 = MMC 的块设备）。本机可能的存储设备如下：
$(printf '%s\n' "$CANDIDATES" | sed 's/^/    /')
请用 --target <设备> 显式指定目标（例如 --target /dev/mmcblk1）。"
        TARGET="$AUTO_TARGET"
        MODE="emmc"
        log "选中 eMMC：${TARGET}（内核 MMC 类型 = MMC）"
    fi
fi

[ -b "$TARGET" ] || die "找不到目标设备 $TARGET"
TARGET_KIND="$(device_kind "$(basename "$TARGET")")"
if [ -n "$FORCE_KIND" ]; then
    # 环设备上跑不了"内核报 MMC 类型"这条路（CI 的假 eMMC 是 loop 设备），
    # 所以给一个显式的类型覆盖开关 —— 主机侧脚本早就有 --force-kind，
    # 设备侧没有 ⇒ **设备侧的 mode=emmc 分支在 CI 里一次都没跑过**，
    # 而两个 P0 缺陷恰好都藏在那条分支里。
    warn "--force-kind：把目标 $TARGET 的类型强制认作 ${FORCE_KIND}（真实类型 ${TARGET_KIND}）"
    TARGET_KIND="$FORCE_KIND"
fi
case "$MODE" in
    auto)
        if [ "$TARGET_KIND" = "emmc" ]; then MODE="emmc"; else MODE="media"; fi
        ;;
    media|emmc) ;;
    *) die "--mode 只能是 media 或 emmc" ;;
esac

if [ "$MODE" = "emmc" ] && [ "$TARGET_KIND" != "emmc" ]; then
    die "模式是 emmc，但目标 $TARGET 不是 eMMC（${TARGET_KIND}）"
fi
if [ "$MODE" = "media" ] && [ "$TARGET_KIND" = "emmc" ]; then
    die "模式是 media（不动 eMMC），但目标是 eMMC $TARGET —— 请改用 --mode emmc"
fi

log "目标：${TARGET}（类型 ${TARGET_KIND}，模式 ${MODE}）"
if [ "$MODE" = "media" ]; then
    log "非破坏性路径：只写 ${TARGET}，eMMC 保持原样 ⇒ 原系统保留，取下介质即可回退"
else
    warn "破坏性路径：会覆盖 $TARGET 的分区表与内容（原系统需要先备份）"
fi

# ---------- [2/6] 检查目标 ----------
step "[2/6] 检查目标状态"

[ "$SRC_DISK" != "$TARGET" ] \
    || die "当前系统就是从 $TARGET 启动的 —— 已经装好了，不要再装一遍"

EXISTING_PARTS="$(lsblk -ndo NAME,TYPE,SIZE "$TARGET" 2>/dev/null | awk '$2=="part"' || true)"
if [ -n "$EXISTING_PARTS" ]; then
    log "目标上已有分区（将被覆盖）："
    printf '%s\n' "$EXISTING_PARTS" | sed 's/^/  /'
    if [ "$ASSUME_YES" != 1 ]; then
        ask "确认覆盖 $TARGET 上的这些分区？输入 yes 继续" "no"
        [ "$REPLY" = "yes" ] || die "已取消（未做任何写入）"
    fi
else
    log "目标上没有分区，是空白设备"
fi

for p in $(lsblk -ndo NAME "$TARGET" 2>/dev/null || true); do
    if findmnt -rn "/dev/$p" >/dev/null 2>&1; then
        die "目标分区 /dev/$p 还挂着，先卸载再安装"
    fi
done

# ---------- [3/6] 网络与 SSH 配置 ----------
step "[3/6] 网络与 SSH 配置"

WORK_PROV="/run/qm1-provision"
rm -rf "$WORK_PROV"
mkdir -p "$WORK_PROV"

# 3a. 先找介质上的 provisioning（ESP 的 /qm1/provision/）
SRC_ESP_MNT="$(mktemp -d)"
if mount -o ro "$SRC_ESP" "$SRC_ESP_MNT" 2>/dev/null; then
    if [ -d "$SRC_ESP_MNT/qm1/provision" ]; then
        cp -a "$SRC_ESP_MNT/qm1/provision/." "$WORK_PROV/" 2>/dev/null || true
        log "已从安装介质读取 provisioning：$SRC_ESP_MNT/qm1/provision"
    fi
    umount "$SRC_ESP_MNT" 2>/dev/null || true
fi
rmdir "$SRC_ESP_MNT" 2>/dev/null || true

# 3b. 命令行指定的 provisioning 目录优先
if [ -n "$PROVISION_DIR" ]; then
    [ -d "$PROVISION_DIR" ] || die "找不到 --provision-dir 指定的目录：$PROVISION_DIR"
    cp -a "$PROVISION_DIR/." "$WORK_PROV/"
    log "已使用指定的 provisioning 目录：$PROVISION_DIR"
fi

# 3c. 交互式补齐 Wi-Fi
#
# psk 的写法有讲究（取值规则见 install-lib.sh 的 qm1_wpa_psk_value）：
# 64 位十六进制 PSK 必须**不加引号**，否则会被当成 64 个字符的口令，
# 超过 wpa_supplicant 的 63 字符上限 —— 现象是"密码明明是对的却连不上"。
write_wifi_conf() {
    _ww_ssid="$1"
    _ww_psk="$2"
    _ww_psk_value=""
    if [ -n "$_ww_psk" ]; then
        if ! _ww_psk_value="$(qm1_wpa_psk_value "$_ww_psk")"; then
            die "Wi-Fi 密码长度非法（${#_ww_psk} 字符）：需要 8..63 字符，或 64 位十六进制"
        fi
    else
        _ww_psk_value=""
    fi
    {
        echo "# 由安装程序生成"
        echo "country=CN"
        echo "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev"
        echo "update_config=1"
        echo "network={"
        echo "    ssid=$(qm1_wpa_ssid_value "$_ww_ssid")"
        if [ -n "$_ww_psk_value" ]; then
            echo "    psk=$_ww_psk_value"
            # 明文口令同时可以当 SAE 口令：路由器是 WPA3-only 或
            # WPA2/WPA3 混合且要求 SAE 时，只有 WPA-PSK 是永远连不上的。
            # 64 位十六进制是 PMK，不能当 SAE 口令 ⇒ 那情况下不给。
            _ww_sae_value="$(qm1_wpa_sae_value "$_ww_psk" || true)"
            [ -n "$_ww_sae_value" ] && echo "    sae_password=$_ww_sae_value"
            [ -n "$_ww_sae_value" ] && echo "    ieee80211w=1"
        fi
        # key_mgmt 里 PSK 在前，wpa_supplicant 先试 PSK ⇒ 纯 WPA2 不受影响；
        # 没有口令时必须是 NONE（否则 wpa_supplicant 拒收整段 network 块）。
        echo "    key_mgmt=$(qm1_wpa_key_mgmt_value "$_ww_psk")"
        echo "}"
    } > "$WORK_PROV/wpa_supplicant.conf"
    chmod 0600 "$WORK_PROV/wpa_supplicant.conf"
}

if [ -n "$SSID" ]; then
    write_wifi_conf "$SSID" "$PSK"
    log "已写入 Wi-Fi 配置：SSID=$SSID"
elif [ -f "$WORK_PROV/wpa_supplicant.conf" ]; then
    log "使用 provisioning 里已有的 Wi-Fi 配置"
else
    if [ -t 0 ]; then
        ask "Wi-Fi SSID（留空则装完再手动配）" ""
        if [ -n "$REPLY" ]; then
            SSID="$REPLY"
            ask "Wi-Fi 密码" ""
            PSK="$REPLY"
            write_wifi_conf "$SSID" "$PSK"
            log "已写入 Wi-Fi 配置：SSID=$SSID"
        fi
    fi
    [ -f "$WORK_PROV/wpa_supplicant.conf" ] \
        || warn "没有 Wi-Fi 配置 —— 装好后需要手动联网（qm1-selftest 里有命令）"
fi

# 3d. SSH
if [ "$ENABLE_SSH" = "yes" ]; then
    : > "$WORK_PROV/ssh"
elif [ "$ENABLE_SSH" = "auto" ]; then
    if [ -t 0 ] && [ ! -f "$WORK_PROV/ssh" ]; then
        ask "是否开机自动启用 SSH？（yes/no）" "yes"
        [ "$REPLY" = "yes" ] && : > "$WORK_PROV/ssh"
    elif [ ! -f "$WORK_PROV/ssh" ]; then
        : > "$WORK_PROV/ssh"
        log "未指定，默认开启 SSH（远程管理需要）"
    fi
fi
[ -f "$WORK_PROV/ssh" ] && log "SSH：装完自动开启"

# 3e. 公钥
if [ -n "$SSH_PUBKEY" ]; then
    [ -f "$SSH_PUBKEY" ] || die "找不到公钥文件：$SSH_PUBKEY"
    cp "$SSH_PUBKEY" "$WORK_PROV/authorized_keys"
    chmod 0600 "$WORK_PROV/authorized_keys"
    : > "$WORK_PROV/ssh"
    log "已带上 SSH 公钥"
fi
[ -n "$SSH_USER" ] && printf '%s\n' "$SSH_USER" > "$WORK_PROV/ssh_user"
[ -n "$HOSTNAME_CFG" ] && printf '%s\n' "$HOSTNAME_CFG" > "$WORK_PROV/hostname"

# ---------- 3f. 把 Wi-Fi 配置写进 live 系统 ----------
# 为什么要写两遍（原来只写了 provisioning 目录）：
#   * provisioning 目录 (/etc/qm1/provision/) 只在**首次开机**时被
#     qm1-firstboot 读取 —— 装完"试用"的那台机器（还是从 U 盘跑）
#     /etc/wpa_supplicant/wpa_supplicant.conf 仍然是全注释 ⇒ 试不联网；
#   * [5/6] 的整盘 dd 会把 live 根分区原样复制到 eMMC ⇒ 这次写入会
#     一起进目标系统，不用再手工补一次。
if [ -f "$WORK_PROV/wpa_supplicant.conf" ]; then
    mount -o remount,rw / 2>/dev/null || true
    install -d -m 0755 /etc/wpa_supplicant
    if cp "$WORK_PROV/wpa_supplicant.conf" /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null; then
        chmod 0600 /etc/wpa_supplicant/wpa_supplicant.conf
        log "已把 Wi-Fi 配置写入本机（会随整盘复制进 eMMC）"
        # 顺手让当前这台（安装环境/试用环境）也用上这份配置
        systemctl enable qm1-wifi@wlan0.service >/dev/null 2>&1 || true
        systemctl restart --no-block qm1-wifi@wlan0.service >/dev/null 2>&1 || true
    else
        warn "无法写入 /etc/wpa_supplicant/wpa_supplicant.conf —— 目标系统里 Wi-Fi 需手工配置"
    fi
fi

# ---------- 3g. 登录账号与口令 ----------
# 镜像里预置了 qm1 用户，但口令是**锁定的**（镜像里不放默认口令 ——
# 一份会被公开仓库分发的镜像不该带任何通用口令）。
# 这里在装机时生成一次性口令写进去，装完就能 SSH 登进去。
#
# 这三步（useradd / chpasswd / sshd 配置）以前是"失败只警告"——
# 于是经常装出一台"有账号但没口令"或者"连账号都没有"的机器，
# 用户只能插着显示器键盘手工收拾。账号装不上 = 装机没完成，直接中止
# （这一步在写盘之前，中止不会留下写了一半的 eMMC）。
if [ "$NO_LOGIN_ACCOUNT" = "1" ]; then
    log "按 --no-login-account 跳过登录账号与口令设置（CI / 无交互验证用）"
elif id "$LOGIN_USER" >/dev/null 2>&1; then
    log "镜像内已有账号：$LOGIN_USER"
else
    command -v useradd >/dev/null 2>&1 \
        || die "镜像里没有 useradd —— 缺少 passwd 包，装机中止。
请在构建镜像时把 passwd 加进 BASE_PKGS（scripts/build-rootfs.sh），再重做镜像。"
    useradd --create-home --shell /bin/bash "$LOGIN_USER" \
        || die "创建账号 $LOGIN_USER 失败 —— 装机中止（还没有对目标盘做任何写入）。
请检查 /etc/passwd 是否可写、passwd 包是否装全，然后重试。"
    usermod -aG sudo "$LOGIN_USER" 2>/dev/null || true
    log "已创建账号：$LOGIN_USER"
fi
if [ "$NO_LOGIN_ACCOUNT" != "1" ] && id "$LOGIN_USER" >/dev/null 2>&1; then
    if [ -z "$SSH_PASSWORD" ]; then
        # 24 位十六进制：够长、不会和 shell/键盘布局打架
        SSH_PASSWORD="$(od -An -tx1 -N 12 /dev/urandom 2>/dev/null | tr -d ' \n')"
    fi
    if [ -n "$SSH_PASSWORD" ]; then
        command -v chpasswd >/dev/null 2>&1 \
            || die "镜像里没有 chpasswd —— 缺少 passwd 包，装机中止。
请在构建镜像时把 passwd 加进 BASE_PKGS（scripts/build-rootfs.sh），再重做镜像。"
        printf '%s:%s\n' "$LOGIN_USER" "$SSH_PASSWORD" | chpasswd \
            || die "设置 $LOGIN_USER 的登录口令失败 —— 装机中止（还没有对目标盘做任何写入）。
请检查 /etc/shadow 是否可写、passwd 包是否装全，然后重试。"
        log "已为 $LOGIN_USER 设置一次性登录口令"
    fi
    # sshd 允许口令登录（仅限这个账号）。
    # 命名必须排在 overlay 里的 sshd_config.d/qm1.conf **之前**
    # （"05-qm1-user.conf" < "qm1.conf"）：sshd 对每个关键字取"第一个取得的值"，
    # 所以这里先给 yes，后面那个全局的 no 对 qm1 就不会再覆盖回来。
    install -d -m 0755 /etc/ssh/sshd_config.d
    cat > /etc/ssh/sshd_config.d/05-qm1-user.conf <<EOF
# 由 QM1 安装程序生成：允许 $LOGIN_USER 用口令登录
# （文件号必须小于 10-qm1.conf —— sshd 取每个关键字的"第一个值"）
Match User $LOGIN_USER
    PasswordAuthentication yes
EOF
    chmod 0644 /etc/ssh/sshd_config.d/05-qm1-user.conf
    systemctl enable ssh.service >/dev/null 2>&1 || true
    printf '%s\n' "$LOGIN_USER" > "$WORK_PROV/ssh_user"
fi

# ---------- [4/6] 备份 ----------
step "[4/6] 备份"

TARGET_BYTES="$(blockdev --getsize64 "$TARGET")"
TARGET_MIB=$(( TARGET_BYTES / 1048576 ))
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_FILE=""
# 恢复命令（把备份写回目标）。尾部备份不是文件，而是"介质 + 字节偏移"，
# 所以命令必须带偏移；用伪路径当 dd 的 if= 是错的（用户照抄必然失败）。
BACKUP_RESTORE_CMD=""
BACKUP_SRC=""        # 备份数据所在（文件或裸设备）
BACKUP_BASE=0        # 备份映像的字节 0 在 BACKUP_SRC 里的偏移

avail_bytes() {
    # 可用空间（字节）。读不到就返回空串，由调用方决定怎么报。
    #
    # ★ 这里原来写的是 `df -PB1 --output=avail "$1" 2>/dev/null`：
    #   -P 是 POSIX 输出格式、--output 是 GNU 扩展；两者一起给，GNU df 会
    #   直接报错退出（非零），而 2>/dev/null 把那句报错吃掉了 ⇒ 输出为空。
    #   再加上脚本开了 pipefail：整条管道因此返回非零，而它又被包在
    #   `need="$(avail_bytes ...)"` 里 ⇒ **set -e 当场退出，一句话都不说** ——
    #   日志上就只剩"[4/6] 备份"这一行，看着像"走到这里就没了"。
    # 现在：不用 -P，两种写法依次试；读不到就明确报出来。
    _ab_row=""
    # 首选：GNU df 的 --output（Debian 目标系统必然有 coreutils）
    _ab_row="$(df -B1 --output=avail "$1" 2>/dev/null | tail -1 | tr -dc '0-9' || true)"
    case "${_ab_row:-}" in
        ''|*[!0-9]*) _ab_row="" ;;
    esac
    if [ -n "$_ab_row" ]; then
        printf '%s' "$_ab_row"
        return 0
    fi
    # 退路：POSIX 的 df -Pk（第 4 列是 1K 块的可用数）
    _ab_row="$(df -Pk "$1" 2>/dev/null \
        | awk 'NR > 1 && $4 ~ /^[0-9]+$/ { print $4; exit }' || true)"
    case "${_ab_row:-}" in
        ''|*[!0-9]*) _ab_row="" ;;
    esac
    if [ -n "$_ab_row" ]; then
        printf '%s' "$(( _ab_row * 1024 ))"
        return 0
    fi
    return 0
}

# 磁盘层面的判断都放在 /usr/local/lib/qm1/install-lib.sh 里（文件在脚本开头
# 已经 source 过）。

# 源盘上最后一个分区的结束位置（字节）
source_used_end() {
    qm1_used_end_bytes "$SRC_DISK"
}

# 源盘尾部**未分区**的空间（U 盘容量大于安装镜像时的"同盘既当启动盘又当备份盘"）
source_tail_bytes() {
    _st_dsize="$(blockdev --getsize64 "$SRC_DISK" 2>/dev/null || echo 0)"
    _st_used="$(source_used_end)"
    # 盘尾留 1 MiB 给 GPT 备份头
    echo $(( _st_dsize - _st_used - 1048576 ))
}

device_hash() {  # $1=偏移 $2=长度
    qm1_hash_range "$TARGET" "$1" "$2"
}

backup_hash() {  # $1=备份映像内偏移 $2=长度
    qm1_hash_range "$BACKUP_SRC" "$(( BACKUP_BASE + $1 ))" "$2"
}

# 逐分区比对备份与原盘 —— 不是只算备份文件自身的哈希
verify_backup_partitions() {
    qm1_verify_backup "$TARGET" "$BACKUP_SRC" "$BACKUP_BASE"
}

# ESP 里到底有没有引导文件。
# 哈希对不上时，这是目标侧能给出的第二个独立证据：
# 根文件系统能被 e2fsck 读通 + ESP 里有 EFI/BOOT/BOOT*.EFI
# ⇒ 目标盘大体是好的（源在复制期间被改过而已）。
esp_has_boot_files() {
    _eb_mnt="$(mktemp -d /tmp/qm1-espchk.XXXXXX)"
    if ! mount -o ro "$1" "$_eb_mnt" 2>/dev/null; then
        rmdir "$_eb_mnt" 2>/dev/null || true
        return 1
    fi
    _eb_found=0
    for _eb_f in "$_eb_mnt"/EFI/BOOT/BOOT*.EFI "$_eb_mnt"/EFI/*/grubx64.efi \
                "$_eb_mnt"/EFI/*/grubia32.efi "$_eb_mnt"/EFI/*/BOOTX64.EFI; do
        if [ -f "$_eb_f" ]; then
            _eb_found=1
        fi
    done
    umount "$_eb_mnt" 2>/dev/null || true
    rmdir "$_eb_mnt" 2>/dev/null || true
    [ "$_eb_found" -eq 1 ]
}

if [ "$MODE" = "emmc" ]; then
    # 覆盖 eMMC 之前必须做完整备份：这是"还能装回原版系统"的唯一保障。
    #
    # 原来这里写死"必须 --backup-dir"，而 GRUB 菜单 ① 并不传它
    # ⇒ 从菜单选"安装到 eMMC"必然在这一步 die。QM1 只有一个 USB-A 口，
    # 现实用法是"把安装镜像 dd 到一个 ≥64GiB 的 U 盘，同盘既当启动盘
    # 又当备份盘"—— 所以这里自己找备份位置：
    #   1) --backup-dir 指定的目录
    #   2) 安装介质上已挂载、且剩余空间足够的目录
    #   3) 安装介质**尾部未分区**的空间（U 盘比安装镜像大时的剩余部分）
    BACKUP_METHOD=""
    if [ -n "$BACKUP_DIR" ]; then
        mkdir -p "$BACKUP_DIR" || die "无法创建备份目录 $BACKUP_DIR"
        need="$(avail_bytes "$BACKUP_DIR")"
        [ "${need:-0}" -ge "$TARGET_BYTES" ] \
            || die "备份目录空间不足：需要 ${TARGET_BYTES} 字节，只有 ${need:-0} 字节"
        BACKUP_METHOD="dir:$BACKUP_DIR"
    else
        for _mp in $(lsblk -nro MOUNTPOINT "$SRC_DISK" 2>/dev/null | grep -v '^$' | sort -u); do
            [ -d "$_mp" ] && [ -w "$_mp" ] || continue
            need="$(avail_bytes "$_mp")"
            [ "${need:-0}" -ge "$TARGET_BYTES" ] || continue
            BACKUP_METHOD="dir:$_mp"
            break
        done
        if [ -z "$BACKUP_METHOD" ]; then
            # ★ 再看**别的**文件系统（第二支 U 盘、外置硬盘……）。
            #   这台机器只有一个 USB-A 口，常见做法是"大 U 盘既当启动盘
            #   又当备份盘"（走下面的尾部未分区空间），但插了第二块盘
            #   时也该自动用上，而不是逼用户去敲 --backup-dir。
            for _mp in $(findmnt -rn -o TARGET 2>/dev/null | sort -u); do
                case "$_mp" in
                    /|/boot|/boot/efi|/efi|/proc|/sys|/dev|/dev/shm|/run) continue ;;
                esac
                [ -d "$_mp" ] && [ -w "$_mp" ] || continue
                need="$(avail_bytes "$_mp")"
                [ "${need:-0}" -ge "$TARGET_BYTES" ] || continue
                BACKUP_METHOD="dir:$_mp"
                break
            done
        fi
        if [ -z "$BACKUP_METHOD" ]; then
            _tail="$(source_tail_bytes)"
            if [ "${_tail:-0}" -ge "$TARGET_BYTES" ]; then
                BACKUP_METHOD="raw:$SRC_DISK"
            fi
        fi
    fi
    [ -n "$BACKUP_METHOD" ] || die "覆盖 eMMC 前必须能放下整盘备份（需要 ${TARGET_BYTES} 字节），但没有找到合适的备份位置。
可用办法（按推荐顺序）：
  1) 用内核参数 qm1.install.backup_dir=<路径> 指定另一块有 ≥28.5GiB 空间的介质上的目录；
  2) 插一支容量 ≥（安装镜像 + 28.5GiB）的 U 盘当启动盘 —— 尾部未分区空间会自动用作备份区；
  3) 插第二块大盘（≥28.5GiB 可用）—— 安装器会自动挑一个可写的挂载点。
注意：单支 32GiB 的 U 盘装不下（镜像本身约 6.3GiB，还要再放 28.5GiB 的备份）。"

    case "$BACKUP_METHOD" in
        dir:*)
            BACKUP_STORE="${BACKUP_METHOD#dir:}"
            BACKUP_FILE="$BACKUP_STORE/qm1-emmc-preinstall-$STAMP.img"
            log "整盘备份 → ${BACKUP_FILE}（${TARGET_MIB} MiB，请耐心）"
            dd if="$TARGET" of="$BACKUP_FILE" bs=4M conv=fsync status=progress
            BACKUP_SRC="$BACKUP_FILE"
            BACKUP_BASE=0
            BACKUP_RESTORE_CMD="dd if=\"$BACKUP_FILE\" of=\"$TARGET\" bs=4M conv=fsync"
            BACKUP_WHERE="目录 ${BACKUP_STORE} 里的文件 ${BACKUP_FILE}（偏移 0）"
            ;;
        raw:*)
            BACKUP_RAW_DEV="${BACKUP_METHOD#raw:}"
            BACKUP_BASE="$(source_used_end)"
            BACKUP_FILE="${BACKUP_RAW_DEV}@${BACKUP_BASE}"
            log "整盘备份 → 安装介质尾部未分区空间（$BACKUP_RAW_DEV 偏移 ${BACKUP_BASE}，${TARGET_MIB} MiB，请耐心）"
            # ★ 偏移必须按**字节**算，不能按 4MiB 块算。
            #   dd 的 seek 以 bs 的块为单位：写 `seek=$((BASE/1048576))` 配 bs=4M
            #   实际落点是 4×BASE（MiB 数当成了 4MiB 块数）——备份会写到
            #   四倍偏移处，随后按正确偏移读回校验必然不一致，安装永远走不完。
            #   这里用 oflag=seek_bytes 让 seek 直接按字节解释；
            #   同一文件里尾部清零用的也是字节精确写法，两处必须一致。
            dd if="$TARGET" of="$BACKUP_RAW_DEV" bs=4M seek="$BACKUP_BASE" \
               oflag=seek_bytes conv=notrunc,fsync status=progress
            BACKUP_SRC="$BACKUP_RAW_DEV"
            # 恢复命令也必须带偏移 —— 备份不在文件里，而在介质的尾部。
            BACKUP_RESTORE_CMD="dd if=\"$BACKUP_RAW_DEV\" of=\"$TARGET\" bs=4M seek=\"$BACKUP_BASE\" oflag=seek_bytes conv=notrunc,fsync"
            BACKUP_WHERE="介质 ${BACKUP_RAW_DEV} 的尾部未分区空间（字节偏移 ${BACKUP_BASE}）"
            ;;
    esac

    # ★ 这段文案在两种备份分支下都可能被用到，所以它只能引用
    #   在**两个分支里都赋值过**的变量。
    #   之前这里写的是 ${BACKUP_RAW_DEV} —— 那个变量只在 raw:* 分支
    #   赋值，dir:* 分支（--backup-dir，也就是 CI 与真机最常用的那条路）
    #   下根本没定义 ⇒ 脚本开了 set -u ⇒ 这段"备份校验失败"的解释
    #   在真正要显示的时候自己先崩了：
    #     line 777: BACKUP_RAW_DEV: unbound variable
    #   用户看到的只有一句 shell 报错，既不知道是备份校验失败，
    #   也不知道"没有对目标做任何写入"。
    #   —— 一条用来解释失败的文案自己失败，等于没写。
    verify_backup_partitions \
        || die "备份校验失败（逐分区 sha256 不一致）—— 中止。没有对 $TARGET 做任何写入。
备份位置：${BACKUP_WHERE:-未知}
先查这三样，再怀疑别的：
  1) 备份是不是写在了预期位置（尾部备份是按**字节**偏移写的：${BACKUP_BASE}）；
  2) 介质是不是掉盘/掉电（U 盘质量、供电）；
  3) 目标盘在备份期间有没有被改过（有人插拔了设备）。
备份不可信就不要继续 —— 这一步没过就等于没有退路。"

    if [ "$ASSUME_YES" != 1 ]; then
        ask "备份已完成并逐分区校验通过，确认覆盖 ${TARGET}？" "no"
        [ "$REPLY" = "yes" ] || die "已取消（未做任何写入）"
    fi
else
    AVAIL="$(avail_bytes /var/tmp || echo 0)"
    if [ "${AVAIL:-0}" -ge "$TARGET_BYTES" ]; then
        BACKUP_FILE="/var/tmp/qm1-target-preinstall-$STAMP.img"
        BACKUP_RESTORE_CMD="dd if=\"$BACKUP_FILE\" of=\"$TARGET\" bs=4M conv=fsync"
        log "介质空间足够，顺手做一份整盘备份 → $BACKUP_FILE"
        dd if="$TARGET" of="$BACKUP_FILE" bs=4M conv=fsync status=progress
        sha256sum "$BACKUP_FILE" > "$BACKUP_FILE.sha256"
    else
        BACKUP_FILE="/var/tmp/qm1-target-metadata-$STAMP.img"
        BACKUP_RESTORE_CMD="（这只是分区表与前 16 MiB 的元数据备份，不是整盘）"
        log "介质空间不够整盘备份，只备份分区表与前 16 MiB → $BACKUP_FILE"
        dd if="$TARGET" of="$BACKUP_FILE" bs=1M count=16 conv=fsync status=none
        sha256sum "$BACKUP_FILE" > "$BACKUP_FILE.sha256"
    fi
fi

# ---------- [5/6] 写入系统 ----------
step "[5/6] 写入系统"

# 源 ESP / 源根分区的字节数：**块设备必须用 blockdev --getsize64**。
# stat -c%s 读的是"设备节点本身"的大小，对块设备恒为 0 ——
# 原来就是用 stat 取的大小，于是"大小必须 > 0"的断言**必然**失败，
# 而且是在两个 dd 都写完之后才失败 ⇒ eMMC 停在写了一半的状态，
# 用户从 U 盘重启看到的只是"启动失败"，查不出真正原因。
SRC_ESP_BYTES="$(blockdev --getsize64 "$SRC_ESP" 2>/dev/null || echo 0)"
SRC_ROOT_BYTES="$(blockdev --getsize64 "$SRC_ROOT" 2>/dev/null || echo 0)"
[ "$SRC_ESP_BYTES" -gt 0 ] \
    || die "读不出源 ESP 大小：${SRC_ESP}（blockdev --getsize64 返回 ${SRC_ESP_BYTES}）"
[ "$SRC_ROOT_BYTES" -gt 0 ] \
    || die "读不出源根分区大小：${SRC_ROOT}（blockdev --getsize64 返回 ${SRC_ROOT_BYTES}）"

# 分区大小按 MiB 向上取整（和 assemble-disk.sh 的口径一致）
ESP_MIB=$(( (SRC_ESP_BYTES + 1048575) / 1048576 ))
[ "$ESP_MIB" -gt 0 ] || die "源 ESP 大小异常：$SRC_ESP_BYTES 字节"
ROOT_START_MIB=$(( 1 + ESP_MIB ))
ROOT_MIB=$(( TARGET_MIB - ROOT_START_MIB - 1 ))
[ "$ROOT_MIB" -gt 0 ] || die "目标盘太小：${TARGET_MIB} MiB"

# 源必须放得进目标分区：否则 dd 会越过分区尾部，把 GPT 备份头冲掉。
[ "$SRC_ESP_BYTES" -le $(( ESP_MIB * 1048576 )) ] \
    || die "源 ESP（$SRC_ESP_BYTES 字节）比目标 ESP 分区还大"
[ "$SRC_ROOT_BYTES" -le $(( ROOT_MIB * 1048576 )) ] \
    || die "源根分区（$SRC_ROOT_BYTES 字节）比目标根分区（${ROOT_MIB} MiB）还大。
换一个更大的目标盘，或先把源缩小。"

log "在 $TARGET 上写分区表：p1 ESP ${ESP_MIB} MiB（EFI System），p2 根分区 ${ROOT_MIB} MiB（Linux）"

SPEC="$(mktemp)"
trap 'rm -f "$SPEC"' EXIT
{
    echo "label: gpt"
    echo "start=1MiB, size=${ESP_MIB}MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
    echo "start=${ROOT_START_MIB}MiB, size=${ROOT_MIB}MiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4"
} > "$SPEC"
LC_ALL=C sfdisk "$TARGET" < "$SPEC" >/dev/null

partprobe "$TARGET" 2>/dev/null || true
udevadm settle 2>/dev/null || true

# 分区设备按**分区类型**认，不按 lsblk 的输出顺序猜。
# 原来直接取 NEWPARTS[0]/[1]，一旦内核给出的顺序变了，就把 ESP 和根分区
# 搞反 —— 结果是 FAT32 的引导分区里装的是 ext4 根文件系统。
#   EFI System  = c12a7328-f81f-11d2-ba4b-00a0c93ec93b
#   Linux fs    = 0fc63daf-8483-4772-8e79-3d69d8477de4
PART1=""
PART2=""
PART1_NO=""
PART2_NO=""
for _ in $(seq 1 20); do
    PART1=""
    PART2=""
    PART1_NO=""
    PART2_NO=""
    # qm1_find_partition_by_type 输出 "名字 分区号 起始 扇区数" 一行。
    # 这里用 awk 取字段，而不是 `while read ... done < <(...)` ——
    # 后者是 bash 专有的进程替换，POSIX sh 没有；而且管道里的 read
    # 在子 shell 中执行，循环里赋的变量出不来。
    _esp_row="$(qm1_find_partition_by_type "$TARGET" "$QM1_PARTTYPE_EFI" || true)"
    _lin_row="$(qm1_find_partition_by_type "$TARGET" "$QM1_PARTTYPE_LINUX" || true)"
    if [ -n "$_esp_row" ]; then
        PART1_NAME="$(printf '%s\n' "$_esp_row" | awk '{print $1}')"
        PART1_NO="$(printf '%s\n' "$_esp_row" | awk '{print $2}')"
        PART1="/dev/$PART1_NAME"
    fi
    if [ -n "$_lin_row" ]; then
        PART2_NAME="$(printf '%s\n' "$_lin_row" | awk '{print $1}')"
        PART2_NO="$(printf '%s\n' "$_lin_row" | awk '{print $2}')"
        PART2="/dev/$PART2_NAME"
    fi
    if [ -n "$PART1" ] && [ -n "$PART2" ]; then
        break
    fi
    sleep 0.5
done
[ -n "$PART1" ] && [ -n "$PART2" ] \
    || die "分区设备没出现或类型不对（等 10 秒仍未看到 EFI System + Linux 文件系统两个分区）"
[ -b "$PART1" ] && [ -b "$PART2" ] || die "分区设备没出现：$PART1 / $PART2"
log "目标分区：${PART1}（ESP，p${PART1_NO}） / ${PART2}（根，p${PART2_NO}）"

# 分区布局自检：写出来的分区表必须与我们打算写的一致
_layout="$(LC_ALL=C sfdisk -d "$TARGET" 2>/dev/null || true)"
if [ -n "$_layout" ]; then
    _n_parts="$(printf '%s\n' "$_layout" | grep -c '^[^#].*start=' || true)"
    [ "${_n_parts:-0}" -eq 2 ] \
        || die "分区布局不对：期望 2 个分区，实际 ${_n_parts:-0} 个"
    _esp_got="$(printf '%s\n' "$_layout" | awk -F': ' '/start=/{print $2; exit}' | cut -d, -f1 | sed 's/.*=//')"
    log "分区布局自检通过（2 个分区，起点 ${_esp_got:-?}）"
fi

# ---------- 源哈希：必须在复制**之前**算 ----------
#
# 原来的顺序是：remount ro → dd → remount rw → 算源哈希 → 比对。
# 问题出在"算源哈希"这一步：它在 remount rw **之后**，而源在 dd 期间是
# 只读的、dd 之后又被改回可写 —— 只要这之后有任何一次写入（系统日志、
# 缓存、第一次启动留下的痕迹），哈希必然对不上 ⇒ 把一次**成功**的安装
# 报成失败，还留下一块"写了一半"的 eMMC。
#
# 现在的顺序：先把源改只读 → 算源哈希 → 再 dd → 再改回可写 → 只校验目标。
CUR_ROOT_SRC="$(findmnt -no SOURCE / 2>/dev/null || true)"
SRC_STABLE=1
if [ "$SRC_ROOT" = "$CUR_ROOT_SRC" ]; then
    if mount -o remount,ro / 2>/dev/null; then
        log "根文件系统已改只读（源内容此刻是稳定的）"
    else
        SRC_STABLE=0
        warn "根文件系统改只读失败 —— 源内容可能在复制期间变化，本次校验按尽力而为处理"
    fi
else
    # CI 里源是另一块环设备，不是正在运行的根：不需要（也不该）动它
    log "源不是当前运行的根文件系统（${CUR_ROOT_SRC}），无需改只读"
fi

SRC_ESP_HASH="$(sha256sum "$SRC_ESP" | awk '{print $1}')"
SRC_ROOT_HASH="$(sha256sum "$SRC_ROOT" | awk '{print $1}')"

log "复制 ESP：$SRC_ESP → $PART1"
dd if="$SRC_ESP" of="$PART1" bs=4M conv=fsync status=progress \
    || die "复制 ESP 失败 —— 中止。目标盘处于写了一半的状态，不要从这里启动。
可用恢复手段：
  1) 上面 [4/6] 的整盘备份：$BACKUP_FILE
     用它恢复：$BACKUP_RESTORE_CMD
  2) 重新跑一遍安装（备份会自动再存一份）。"
log "复制根文件系统：$SRC_ROOT → $PART2"
dd if="$SRC_ROOT" of="$PART2" bs=4M conv=fsync status=progress \
    || die "复制根文件系统失败 —— 中止。目标盘处于写了一半的状态，不要从这里启动。
可用恢复手段：
  1) 上面 [4/6] 的整盘备份：$BACKUP_FILE
     用它恢复：$BACKUP_RESTORE_CMD
  2) 重新跑一遍安装（备份会自动再存一份）。"

if [ "$SRC_ROOT" = "$CUR_ROOT_SRC" ]; then
    mount -o remount,rw / 2>/dev/null || warn "根文件系统改回可写失败（继续）"
fi

# ---------- 校验：只信目标 ----------
#
# 写完之后从**目标**上把刚写进去的那几个字节读回来算哈希，
# 和复制前算好的源哈希比。目标上读回来的内容不受"源后来又被写过"影响。
log "校验：逐分区比对 sha256（刚写入、未做后续改动的状态）"
DST_ESP_HASH="$(qm1_hash_range "$PART1" 0 "$SRC_ESP_BYTES")"
DST_ROOT_HASH="$(qm1_hash_range "$PART2" 0 "$SRC_ROOT_BYTES")"

rc=0
if [ "$SRC_ESP_HASH" = "$DST_ESP_HASH" ]; then
    log "ESP 写入校验通过：$DST_ESP_HASH"
else
    warn "ESP 写入校验不一致：源 $SRC_ESP_HASH / 目标 $DST_ESP_HASH"
    rc=1
fi
if [ "$SRC_ROOT_HASH" = "$DST_ROOT_HASH" ]; then
    log "根文件系统写入校验通过：$DST_ROOT_HASH"
else
    warn "根文件系统写入校验不一致：源 $SRC_ROOT_HASH / 目标 $DST_ROOT_HASH"
    rc=1
fi

if [ "$rc" -ne 0 ]; then
    # 哈希对不上有两种完全不同的原因，处理方式必须分开：
    #   a) 源在复制期间被写过（源哈希"漂移"）—— 此时不一致可能是假警报；
    #   b) 真的写坏了（源没变，目标不对）—— 必须中止。
    # 现在再算一次源哈希：它变了 ⇒ 情况 a；没变 ⇒ 情况 b。
    SRC_ESP_HASH2="$(sha256sum "$SRC_ESP" | awk '{print $1}')"
    SRC_ROOT_HASH2="$(sha256sum "$SRC_ROOT" | awk '{print $1}')"
    if [ "$SRC_ESP_HASH" != "$SRC_ESP_HASH2" ] || [ "$SRC_ROOT_HASH" != "$SRC_ROOT_HASH2" ]; then
        warn "源在复制期间被写过（哈希漂移）：$SRC_ROOT_HASH → $SRC_ROOT_HASH2"
        if [ "$SRC_STABLE" -eq 0 ]; then
            warn "源当时没能改只读 —— 这次不一致可能只是源在变，不能据此判定写盘失败"
        fi
        # 源漂移 ⇒ 哈希不足为凭，改用目标侧的硬校验来定论：
        #   根文件系统必须能通过 e2fsck，ESP 里必须有引导文件。
        e2fsck -fp "$PART2" >/dev/null 2>&1 || e2fsck -f "$PART2" >/dev/null 2>&1 || true
        if e2fsck -fn "$PART2" >/dev/null 2>&1; then
            log "目标根文件系统 e2fsck -fn 检查通过"
        else
            die "目标根文件系统检查不通过（e2fsck -fn）—— 写盘确实坏了，中止。
$TARGET 处于写了一半的状态，不要从这里启动。
可用恢复手段：
  1) 上面 [4/6] 的整盘备份：$BACKUP_FILE
     用它恢复：$BACKUP_RESTORE_CMD
  2) 重新跑一遍安装（备份会自动再存一份）。"
        fi
        if esp_has_boot_files "$PART1"; then
            log "目标 ESP 引导文件检查通过（EFI/BOOT/BOOT*.EFI）"
        else
            die "目标 ESP 里没有找到引导文件（EFI/BOOT/BOOT*.EFI）—— 写盘确实坏了，中止。
$TARGET 处于写了一半的状态，不要从这里启动。
可用恢复手段：
  1) 上面 [4/6] 的整盘备份：$BACKUP_FILE
     用它恢复：$BACKUP_RESTORE_CMD
  2) 重新跑一遍安装（备份会自动再存一份）。"
        fi
    else
        # 校验失败 = 写盘没成功，继续往下走只会留下一个"装了一半"的 eMMC，
        # 而用户从 U 盘重启后看到的现象是"启动失败"，却查不出真正原因。
        # 这里必须立刻中止，并说清楚当前 eMMC 处于什么状态、怎么恢复。
        die "写入校验失败 —— 中止，没有做后续改动（菜单、provisioning、安装记录都没做）。
$TARGET 现在处于**写了一半**的状态，不要从这里启动。
可用的恢复手段：
  1) 上面 [4/6] 的整盘备份：$BACKUP_FILE
     用它恢复：$BACKUP_RESTORE_CMD
  2) 重新跑一遍安装（备份会自动再存一份）。
先把 U 盘插好、别拔，然后重新启动到安装介质再试。"
    fi
fi

# 目标根分区比镜像大：dd 只写了源根分区那么大一截，剩下的区域还是
# **上一套系统的残留**（可能含旧文件、旧凭据）。先把多出来的部分清零，
# 后面 resize2fs 扩出来的空闲块里才不会留着旧数据。
ROOT_TAIL_BYTES=$(( ROOT_MIB * 1048576 - SRC_ROOT_BYTES ))
if [ "$ROOT_TAIL_BYTES" -gt 0 ]; then
    log "清空根分区尾部残留：$(( ROOT_TAIL_BYTES / 1048576 )) MiB"
    # 用字节精确的 skip/count：按 MiB 取整会越过分区尾，撞上 GPT 备份头。
    dd if=/dev/zero of="$PART2" bs=1M iflag=skip_bytes,count_bytes \
        skip="$SRC_ROOT_BYTES" count="$ROOT_TAIL_BYTES" \
        conv=notrunc,fsync status=progress \
        || warn "清零根分区尾部失败（继续，resize2fs 仍可继续）"
fi

# ---------- [6/6] 收尾 ----------
step "[6/6] 收尾（菜单、provisioning、安装记录）"

# 6a. 换回正常菜单（安装介质的 grub.cfg 是安装菜单）
SRC_ESP_MNT="$(mktemp -d)"
DST_ESP_MNT="$(mktemp -d)"
if mount "$SRC_ESP" "$SRC_ESP_MNT" 2>/dev/null \
   && [ -f "$SRC_ESP_MNT/EFI/BOOT/grub-normal.cfg" ]; then
    if mount "$PART1" "$DST_ESP_MNT" 2>/dev/null; then
        cp "$SRC_ESP_MNT/EFI/BOOT/grub-normal.cfg" "$DST_ESP_MNT/EFI/BOOT/grub.cfg"
        sync
        umount "$DST_ESP_MNT"
        log "目标 ESP 的 grub.cfg 已换成正常菜单"
    else
        warn "挂载目标 ESP 失败 —— 目标 ESP 保留安装菜单"
    fi
else
    warn "源 ESP 里没有 grub-normal.cfg —— 目标 ESP 保留安装菜单"
fi
umount "$SRC_ESP_MNT" 2>/dev/null || true
rmdir "$SRC_ESP_MNT" "$DST_ESP_MNT" 2>/dev/null || true

# 6b. provisioning 写进目标（ESP 的 /qm1/provision/ 与根分区的 /etc/qm1/provision/）
if [ -n "$(ls -A "$WORK_PROV" 2>/dev/null || true)" ]; then
    DST_ESP_MNT="$(mktemp -d)"
    if mount "$PART1" "$DST_ESP_MNT" 2>/dev/null; then
        mkdir -p "$DST_ESP_MNT/qm1/provision"
        cp -a "$WORK_PROV/." "$DST_ESP_MNT/qm1/provision/"
        sync
        umount "$DST_ESP_MNT"
        log "provisioning 已写入目标 ESP 的 /qm1/provision/"
    else
        warn "挂载目标 ESP 失败 —— provisioning 只写根分区"
    fi
    rmdir "$DST_ESP_MNT" 2>/dev/null || true
fi

# 6c. 撑满整盘 + 检查
log "把根分区撑满整个分区（${ROOT_MIB} MiB）"
e2fsck -fp "$PART2" >/dev/null 2>&1 || e2fsck -f "$PART2" || true
resize2fs "$PART2" >/dev/null
if e2fsck -fn "$PART2" >/dev/null 2>&1; then
    log "撑大后的文件系统检查通过（e2fsck -fn 无错误）"
else
    warn "撑大后的文件系统检查有告警（e2fsck -fn）——建议手动再跑一次 fsck"
    rc=1
fi

# 6d. provisioning + 安装记录写进目标根文件系统
DST_ROOT_MNT="$(mktemp -d)"
if mount "$PART2" "$DST_ROOT_MNT" 2>/dev/null; then
    if [ -n "$(ls -A "$WORK_PROV" 2>/dev/null || true)" ]; then
        mkdir -p "$DST_ROOT_MNT/etc/qm1/provision"
        cp -a "$WORK_PROV/." "$DST_ROOT_MNT/etc/qm1/provision/"
        log "provisioning 已写入目标根分区：/etc/qm1/provision/"
    fi
    {
        echo "installed_at=$(date -Is)"
        echo "target=$TARGET"
        echo "mode=$MODE"
        echo "source=$SRC_DISK"
        echo "esp_sha256_at_write=$DST_ESP_HASH"
        echo "rootfs_sha256_at_write=$DST_ROOT_HASH"
        echo "backup=${BACKUP_FILE:-none}"
        [ -n "$LOGIN_USER" ] && echo "ssh_user=$LOGIN_USER"
        [ -n "$SSH_PASSWORD" ] && echo "ssh_password=$SSH_PASSWORD"
    } > "$DST_ROOT_MNT/etc/qm1-installed-to-emmc" 2>/dev/null \
        || warn "安装记录写入目标根分区失败"
    chmod 0600 "$DST_ROOT_MNT/etc/qm1-installed-to-emmc" 2>/dev/null || true
    sync
    umount "$DST_ROOT_MNT"
    log "安装记录已写入目标根分区：/etc/qm1-installed-to-emmc"
else
    warn "挂载目标根分区失败 —— 安装记录没能写进目标"
fi
rmdir "$DST_ROOT_MNT" 2>/dev/null || true

# 6e. 登记 UEFI 启动项
#
# 原来这一步整个没有 —— 刷完 eMMC 后，固件里没有指向新系统的启动项，
# 结果就是"装完了，但开机还是进原来的系统（或没有系统）"。
#
# 登记**哪一个**引导器，这里有个容易踩的坑：
#   ESP 上有两条可引导文件（make-esp.sh 写入）：
#     \EFI\BOOT\BOOTIA32.EFI —— PE32（32 位）
#     \EFI\BOOT\BOOTX64.EFI  —— PE32+（64 位）
#   **IA32 的固件根本加载不了 PE32+ 的 BOOTX64.EFI**，而 64 位固件按 UEFI
#   规范必须能加载 IA32 应用 ⇒ 只有 BOOTIA32.EFI 是"两种固件都能加载"的那条。
#   这台机器的固件就是 32 位 IA32（ASUS 给这批平板点的 EDK 只支持 IA32），
#   所以优先登记 BOOTIA32.EFI；ESP 里没有它才退回 BOOTX64.EFI。
#   之前这里优先登记 BOOTX64.EFI：在 32 位固件上登记出来的是一条**加载不了**
#   的启动项，等于白登记。
# efibootmgr 不可用时靠 \EFI\BOOT\ 兜底路径 + 手工命令。
EFI_ENTRY_DONE="no"
EFI_LOADER=""
if [ "$SKIP_EFI_ENTRY" -eq 1 ]; then
    # 显式跳过：只在"确实没法登记"时用（例如 CI 的环设备上没有 efivars）。
    # 必须是**显式**的 —— 悄悄跳过却报成功是最坏的结果。
    EFI_ENTRY_DONE="skipped"
    warn "按 --skip-efi-entry 显式跳过 EFI 启动项登记"
elif [ -e "$EFIVARS_PATH" ]; then
    if command -v efibootmgr >/dev/null 2>&1; then
        _esp_mnt="$(mktemp -d)"
        if mount "$PART1" "$_esp_mnt" 2>/dev/null; then
            if [ -f "$_esp_mnt/EFI/BOOT/BOOTIA32.EFI" ]; then
                EFI_LOADER='\EFI\BOOT\BOOTIA32.EFI'
            elif [ -f "$_esp_mnt/EFI/BOOT/BOOTX64.EFI" ]; then
                EFI_LOADER='\EFI\BOOT\BOOTX64.EFI'
            fi
            if [ -n "$EFI_LOADER" ]; then
                if efibootmgr -c -d "$TARGET" -p "$PART1_NO" -L "QM1 Debian" \
                        -l "$EFI_LOADER" 2>/dev/null; then
                    log "已登记 UEFI 启动项：QM1 Debian（${EFI_LOADER}，磁盘 $TARGET 分区 p${PART1_NO}）"
                    EFI_ENTRY_DONE="yes"
                else
                    warn "efibootmgr 登记启动项失败（可以稍后手工执行，见下方提示）"
                fi
            else
                warn "目标 ESP 里没有 \EFI\BOOT\BOOTIA32.EFI / BOOTX64.EFI —— 无法登记启动项"
            fi
            umount "$_esp_mnt" 2>/dev/null || true
        else
            warn "挂载目标 ESP 失败 —— 无法登记 UEFI 启动项"
        fi
        rmdir "$_esp_mnt" 2>/dev/null || true
    else
        warn "镜像里没有 efibootmgr —— 无法自动登记 UEFI 启动项"
    fi
else
    warn "当前不是以 UEFI 模式启动（没有 ${EFIVARS_PATH}）—— 无法登记 UEFI 启动项"
fi
if [ "$EFI_ENTRY_DONE" != "yes" ]; then
    cat <<EOF
  手工登记（进入已装好的系统后执行，或从 U 盘的安装环境执行）：
    efibootmgr -c -d $TARGET -p $PART1_NO -L "QM1 Debian" -l '\\EFI\\BOOT\\BOOTIA32.EFI'
    efibootmgr -o 1        # 可选：把它设为第一启动项
  兜底：\\EFI\\BOOT\\BOOTIA32.EFI 是固件的可引导路径，多数固件会自动找到它
  （BOOTX64.EFI 只有在固件是 64 位时才加载得了，别优先用它）。
EOF
fi

# 登记不上就必须判失败 —— 系统已经装好了，可固件里没有指向它的启动项，
# 用户重开机看到的只有"开不了机"，而报告却说装好了。
# 只有显式 --skip-efi-entry 才允许带着"没登记"的状态收场。
if [ "$EFI_ENTRY_DONE" != "yes" ] && [ "$SKIP_EFI_ENTRY" -ne 1 ]; then
    die "EFI 启动项没有登记成功 —— 不能报成功（固件里没有指向 $TARGET 的启动项）。
系统本身已经装好了（目标 ${TARGET}，根分区 ${PART2}），缺的是启动项。
★ 别重跑安装：重跑会把刚装好的系统再擦一遍。
兜底：多数固件会自动从 \\EFI\\BOOT\\ 找引导器，ESP 上的 BOOTIA32.EFI 就是为此放的
（BOOTX64.EFI 只有在固件是 64 位时才加载得了，别优先用它）——
所以重开机时如果固件菜单里能看到 eMMC，就选它；看不到再用上面的 efibootmgr 命令登记。
补救（进入已装好的系统后执行，或从 U 盘的安装环境执行）：
  efibootmgr -c -d $TARGET -p $PART1_NO -L \"QM1 Debian\" -l '\\EFI\\BOOT\\BOOTIA32.EFI'
  efibootmgr -o 1
确实没法登记时（比如这台机器压根没在 UEFI 模式下启动），
可以显式加 --skip-efi-entry 跳过这一步 —— 但那样机器多半开不了机。"
fi

echo
echo "================================================================"
if [ "$rc" -eq 0 ]; then
    echo " 安装完成 ✅"
else
    echo " 安装结束，但校验有失败项 ⚠️（见上面的 sha256 对比）"
fi
echo " 目标设备 : ${TARGET}（模式 ${MODE}）"
echo " 根分区   : $PART2"
echo " 备份     : ${BACKUP_FILE:-none}"
if [ "$EFI_ENTRY_DONE" = "yes" ]; then
    echo " UEFI 启动项 : 已登记（QM1 Debian）"
elif [ "$EFI_ENTRY_DONE" = "skipped" ]; then
    echo " UEFI 启动项 : 未登记（--skip-efi-entry 显式跳过，见上面的手工命令）"
else
    echo " UEFI 启动项 : 未登记 —— 见上面的手工命令"
fi
if [ "$MODE" = "media" ]; then
    echo " eMMC     : 未触碰（原系统保留，可随时取下 $TARGET 回退）"
fi
echo
echo " 接下来："
echo "   1. 拔掉安装介质"
if [ "$MODE" = "media" ]; then
    echo "   2. 重新开机，在 BIOS 里选 $TARGET 启动（不要选 eMMC）"
else
    echo "   2. 重新开机，在 BIOS 里选 eMMC（内部存储）启动"
fi
if [ -f "$WORK_PROV/wpa_supplicant.conf" ]; then
    echo "   3. 首次开机会自动联网（Wi-Fi 配置已随系统装好）"
else
    echo "   3. 首次开机后需要手动联网（本次没有 Wi-Fi 配置）"
fi
echo "   4. 登录后跑：sudo /usr/local/bin/qm1-selftest"
if [ -n "$LOGIN_USER" ]; then
    echo
    echo " 登录凭据（仅此一次，请立即抄下来并改掉口令）："
    echo "   用户名 : $LOGIN_USER"
    if [ -n "$SSH_PASSWORD" ]; then
        echo "   口令   : $SSH_PASSWORD"
    else
        echo "   口令   : 未自动生成（请用 sudo passwd $LOGIN_USER 设置）"
    fi
    echo "   改口令 : passwd $LOGIN_USER"
    echo "   记录位置：目标根分区 /etc/qm1-installed-to-emmc（权限 0600）"
fi
echo "================================================================"
exit "$rc"
