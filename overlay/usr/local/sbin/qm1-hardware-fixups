#!/bin/sh
# qm1-hardware-fixups -- make every function of the QM1 work the way the
# hardware is supposed to work, not just "load a module and hope".
#
# Each block below targets one function and explains what it changes and why.
# Nothing here is cosmetic: every write either removes a known failure mode
# or brings back a capability that the stock configuration leaves off.
#
# Override with /etc/default/qm1-hardware (see the file for the knobs).
#
# NOTE about timing: this unit runs at multi-user, which is *late* for the
# eMMC (the root filesystem has already been read from it by then).  The
# runtime-suspend switch therefore also lives in a udev rule
# (/etc/udev/rules.d/60-qm1-emmc-power.rules) which is applied as soon as the
# host is enumerated, i.e. already during the initramfs stage.

set -eu

LOG=/var/log/qm1-hardware-fixups.log
CONF=/etc/default/qm1-hardware
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

# Qm1_MAX_FREQ_PERC: cap the intel_pstate frequency (percent of the top step).
# Empty means no cap.  The case has no active cooling and throttles at 85 C,
# so a cap trades a little speed for a stable temperature.
Qm1_MAX_FREQ_PERC="${Qm1_MAX_FREQ_PERC:-}"
# Qm1_EMMC_RUNTIME_PM: "off" keeps the eMMC controller out of runtime
# suspend.  The Bay Trail SD host can leave a transfer half finished when it
# suspends mid-DMA, which shows up as "Reset never completed".
Qm1_EMMC_RUNTIME_PM="${Qm1_EMMC_RUNTIME_PM:-off}"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" 2>/dev/null >>"$LOG" || true; }
# Also to the journal, so a failure is visible without tailing a file.
jlog() { logger -t qm1-hardware-fixups -- "$*" 2>/dev/null || true; }
logboth() { log "$*"; jlog "$*"; }

# ---------------------------------------------------------------------------
# 1. eMMC: keep the SD host awake
#
# sdhci-acpi only enables runtime suspend when the firmware sets the
# SDHCI_ACPI_RUNTIME_PM flag.  When it is set, the controller is suspended 50 ms
# after the last request, and a request that arrives during suspend is lost --
# the card then reports a timeout or a failed reset.  The kernel exposes the
# switch per device, so we turn it off at the device level instead of
# blacklisting a module.
#
# The host is *discovered*, not hardcoded: on this machine the eMMC sits on
# ACPI 80860F14:00 and the microSD slot on 80860F14:01, but a hardcoded path
# that silently stops matching would look like "nothing to do".  Instead we
# walk the MMC block devices, keep the one whose device type is MMC (the
# eMMC -- SD cards report SD and the Wi-Fi card reports SDIO), and follow it
# up to the platform device that owns the host.
# ---------------------------------------------------------------------------

# Print the platform device that hosts the eMMC, if any.
emmc_host_platform() {
    for blk in /sys/class/block/mmcblk*; do
        [ -e "$blk" ] || continue
        card="$(readlink -f "$blk/device" 2>/dev/null || true)"
        [ -n "$card" ] || continue
        type="$(cat "$card/type" 2>/dev/null || true)"
        [ "$type" = "MMC" ] || continue
        # Follow driver ownership rather than assuming a fixed sysfs depth.
        # Firmware can put the controller below an ACPI or PCI parent.
        host="$card"
        while [ "$host" != /sys/devices ] && [ "$host" != / ]; do
            owner="$(basename "$(readlink -f "$host/driver" 2>/dev/null || echo none)")"
            case "$owner" in
                sdhci-acpi|sdhci-pci|sdhci_acpi|sdhci_pci)
                    printf '%s' "$host"
                    return 0 ;;
            esac
            host="${host%/*}"
        done
    done
    return 1
}

emmc_fixup() {
    host="$(emmc_host_platform || true)"
    if [ -z "$host" ]; then
        logboth "eMMC: no MMC-type block device found -- the eMMC host is NOT protected against runtime suspend"
        logboth "eMMC: check 'ls /sys/class/block' and 'cat /sys/class/block/mmcblk*/device/type'"
        return 0
    fi
    log "eMMC: host platform device = $host"

    if [ "$Qm1_EMMC_RUNTIME_PM" != "off" ]; then
        log "eMMC: runtime PM left as configured ($Qm1_EMMC_RUNTIME_PM)"
        return 0
    fi

    rc=0
    if [ -w "$host/power/control" ]; then
        before="$(cat "$host/power/control" 2>/dev/null || echo unknown)"
        if echo on >"$host/power/control" 2>/dev/null; then
            after="$(cat "$host/power/control" 2>/dev/null || echo unknown)"
            if [ "$after" != on ]; then
                logboth "eMMC runtime PM: control readback is $after (expected on)"
                rc=1
            elif [ "$before" != "$after" ]; then
                logboth "eMMC runtime PM: control $before -> $after"
            else
                log "eMMC runtime PM: already $after"
            fi
        else
            logboth "eMMC runtime PM: could not write $host/power/control (still $before)"
            rc=1
        fi
    else
        logboth "eMMC runtime PM: $host/power/control is not writable"
        rc=1
    fi

    # autosuspend_delay_ms = -1 means "never suspend automatically"
    if [ -w "$host/power/autosuspend_delay_ms" ]; then
        if echo -1 >"$host/power/autosuspend_delay_ms" 2>/dev/null; then
            got="$(cat "$host/power/autosuspend_delay_ms" 2>/dev/null || echo unknown)"
            if [ "$got" = "-1" ]; then
                log "eMMC runtime PM: autosuspend_delay_ms = -1"
            else
                logboth "eMMC runtime PM: autosuspend_delay_ms = $got (expected -1)"
                rc=1
            fi
        else
            logboth "eMMC runtime PM: could not write $host/power/autosuspend_delay_ms"
            rc=1
        fi
    else
        log "eMMC runtime PM: $host/power/autosuspend_delay_ms not writable (nothing to disable)"
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# 2. CPU frequency: let the governor do its job
#
# The 1.33 GHz step is not a hardware limit.  intel_pstate knows the Silvermont
# P-state table, so the CPU can drop to 800 MHz when it is idle.  If the
# governor is stuck at performance, the chip never leaves the top step and it
# runs hot for no reason.
# ---------------------------------------------------------------------------
cpufreq_fixup() {
    gov_path=""
    for d in /sys/devices/system/cpu/cpu0/cpufreq /sys/devices/system/cpu/cpufreq/policy0; do
        [ -d "$d" ] && { gov_path="$d"; break; }
    done
    if [ -z "$gov_path" ]; then
        log "cpufreq: no cpufreq policy found (the CPU may run at a fixed step)"
        return 0
    fi
    cur=$(cat "$gov_path/scaling_governor" 2>/dev/null || echo unknown)
    log "cpufreq: governor=$cur"
    driver="$(cat "$gov_path/scaling_driver" 2>/dev/null || echo unknown)"
    # intel_pstate 的 powersave 是动态调频；通用 cpufreq 的 powersave 则锁最低频率。
    # 后者选 schedutil/ondemand，避免误把整机固定在最低频。
    available="$(cat "$gov_path/scaling_available_governors" 2>/dev/null || true)"
    desired=""
    case "$driver" in
        intel_pstate) candidates="powersave" ;;
        *) candidates="schedutil ondemand" ;;
    esac
    for candidate in $candidates; do
        case " $available " in *" $candidate "*) desired="$candidate"; break ;; esac
    done
    if [ -n "$desired" ] && [ -w "$gov_path/scaling_governor" ] && [ "$cur" != "$desired" ]; then
        echo "$desired" >"$gov_path/scaling_governor" 2>/dev/null \
            && log "cpufreq: governor set to $desired ($driver)" \
            || log "cpufreq: could not change the governor"
    fi
    if [ -n "$Qm1_MAX_FREQ_PERC" ] && [ -w /sys/devices/system/cpu/intel_pstate/max_perf_pct ]; then
        case "$Qm1_MAX_FREQ_PERC" in
            *[!0-9]*|0|'') logboth "intel_pstate: invalid frequency cap"; return 0 ;;
        esac
        [ "$Qm1_MAX_FREQ_PERC" -le 100 ] || { logboth "intel_pstate: cap must be 1..100"; return 0; }
        echo "$Qm1_MAX_FREQ_PERC" >/sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null \
            && log "intel_pstate: max frequency capped at ${Qm1_MAX_FREQ_PERC}%" \
            || log "intel_pstate: could not cap the frequency"
    fi
}

# ---------------------------------------------------------------------------
# 3. HDMI audio: load the codec the display driver needs
#
# i915 creates an hdmi-lpe-audio platform device on Bay Trail without an HDA
# controller. It needs snd_hdmi_lpe_audio, not an HDA codec. Keep the HDA path
# as well for hardware that actually exposes HDA.
# ---------------------------------------------------------------------------
audio_fixup() {
    if grep -qw i915 /proc/modules 2>/dev/null; then
        for m in snd-hdmi-lpe-audio snd-hda-codec-hdmi; do
            if modprobe "$m" 2>/dev/null; then
                log "audio: loaded $m"
            else
                logboth "audio: could not load $m"
            fi
        done
    fi
}

# ---------------------------------------------------------------------------
# 4. Bluetooth: make sure the UART controller is bound to hci_uart
#
# The ACPI device (OBDA8723 / OBDA0623) already has a matching alias in
# hci_uart, so the controller shows up as soon as the module is loaded.  The
# firmware itself comes from the distribution package (rtl_bt/rtl8723bs_fw.bin)
# and is pushed by the kernel btrtl driver -- qm1-bluetooth.service only waits
# for hci0.
#
# UART controller binding and Bluetooth serdev child binding are distinct.
# A serial controller driver can be required to enumerate the H5 child;
# missing hci0 alone does not justify blacklisting or a DSDT override.
# ---------------------------------------------------------------------------
bluetooth_fixup() {
    modprobe hci_uart 2>/dev/null || true
    if [ -d /sys/class/bluetooth/hci0 ]; then
        log "bluetooth: $(ls /sys/class/bluetooth | tr '\n' ' ')"
        return 0
    fi

    # No hci device.  Find the Bluetooth ACPI node and see who owns it.
    bt_acpi=""
    bt_driver=""
    for dev in /sys/bus/acpi/devices/*; do
        [ -e "$dev" ] || continue
        hid="$(cat "$dev/hid" 2>/dev/null || true)"
        case "$hid" in
            OBDA8723|OBDA0623) bt_acpi="$dev"; bt_driver="$(basename "$(readlink -f "$dev/physical_node/driver" 2>/dev/null || readlink -f "$dev/driver" 2>/dev/null || echo none)")" ;;
        esac
    done

    if [ -n "$bt_acpi" ]; then
        logboth "bluetooth: NO hci device; ACPI node $bt_acpi is bound to driver '$bt_driver'"
        case "$bt_driver" in
            8250*|serial*)
                logboth "bluetooth: inspect the UART parent and H5 serdev child separately; do not blacklist a controller based only on this owner"
                ;;
            hci_uart*)
                logboth "bluetooth: hci_uart owns the node but no hci device appeared -- check 'dmesg | grep -i hci_uart' and the firmware blob"
                ;;
            none)
                logboth "bluetooth: no bound driver observed; inspect serdev enumeration, UART/GPIO dependencies and probe errors before considering ACPI changes"
                ;;
            *)
                logboth "bluetooth: unexpected owner '$bt_driver' on the Bluetooth ACPI node"
                ;;
        esac
    else
        logboth "bluetooth: no hci device and no OBDA8723/OBDA0623 ACPI node -- the DSDT does not expose the Bluetooth UART"
    fi

    if [ -d /sys/bus/serial/drivers/hci_uart_h5 ]; then
        log "bluetooth: the hci_uart_h5 serdev driver is registered"
    fi
}

# ---------------------------------------------------------------------------
# 5. DMI identity and the microSD card-detect quirk
#
# The microSD slot on this platform needs a pull-up on the card-detect GPIO;
# the firmware DSDT declares it as GpioInt(... PullNone ...), which Linux
# honours, so the slot never sees a card.  Upstream fixed this in
# drivers/mmc/host/sdhci-acpi.c with DMI_QUIRK_SD_CD_ENABLE_PULL_UP, matched
# on DMI_SYS_VENDOR "ASUSTeK COMPUTER INC." + DMI_PRODUCT_NAME "T100TA".
#
# That quirk ships in every kernel since v6.10, so Debian 6.12 already has
# it -- but only if this board reports that exact product name.  Report the
# identity and whether the quirk can possibly apply, instead of silently
# leaving a dead slot behind.
# ---------------------------------------------------------------------------
dmi_report() {
    id="/sys/devices/virtual/dmi/id"
    vendor="$(cat "$id/sys_vendor" 2>/dev/null || echo unknown)"
    product="$(cat "$id/product_name" 2>/dev/null || echo unknown)"
    board="$(cat "$id/board_name" 2>/dev/null || echo unknown)"
    log "dmi: vendor='$vendor' product='$product' board='$board'"

    case "$vendor:$product" in
        *ASUSTeK*:*T100TA*)
            log "dmi: upstream sdhci-acpi card-detect pull-up quirk applies to this board"
            ;;
        *)
            logboth "dmi: the sdhci-acpi card-detect quirk matches 'ASUSTeK COMPUTER INC.'+T100TA only"
            logboth "dmi: on this board it does NOT apply, so the microSD slot may stay undetected"
            ;;
    esac

    # Is an SD card actually visible right now?
    for b in /sys/class/block/mmcblk*; do
        [ -e "$b" ] || continue
        dev="$(readlink -f "$b/device" 2>/dev/null || true)"
        type="$(cat "$dev/type" 2>/dev/null || echo unknown)"
        [ "$type" = "SD" ] && log "dmi: SD card present on $b ($dev)"
    done
    return 0
}

emmc_fixup || logboth "eMMC fixup reported a problem (see above)"
cpufreq_fixup
audio_fixup
bluetooth_fixup
dmi_report

log "qm1-hardware-fixups: done"
