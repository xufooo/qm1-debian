#!/bin/sh
# qm1-provision — 首次启动后自动部署 agent 运行时（Hermes CLI + headless Chrome）
#
# 为什么要有这一层：
#   provision-agent.sh 是"装完系统之后再手动跑"的脚本，但交付口径是
#   "装进 eMMC、开机即用" —— 刷完机第一次开机，就应该把运行时铺好，
#   而不是让人先 SSH 进来敲一行命令。
#
#   它只做三件事：找到 provision-agent.sh、跑它、成功后写一个标记。
#   标记是 ConditionPathExists=! 的判据：失败或没跑成，下次开机自动重试。
set -eu

AGENT="/usr/local/share/qm1/provision-agent.sh"
MARKER="/var/lib/qm1/provision-done"

if [ ! -x "$AGENT" ]; then
    echo "qm1-provision: 镜像里没有 $AGENT，跳过运行时部署" >&2
    exit 0
fi

mkdir -p "$(dirname "$MARKER")"

if bash "$AGENT"; then
    : > "$MARKER"
    echo "qm1-provision: 运行时部署完成（标记 $MARKER）"
else
    rc=$?
    echo "qm1-provision: 运行时部署失败（rc=$rc），下次开机自动重试" >&2
    exit "$rc"
fi
