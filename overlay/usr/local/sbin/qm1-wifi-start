#!/bin/sh
# qm1-wifi-start — 等无线接口出现，然后把控制权交给 wpa_supplicant
#
# 为什么等待必须发生在**这个进程内部**，而不是单元的 ExecStartPre 里：
#
#   ExecStartPre 属于单元的 start job。start job 没结束，依赖它的
#   **multi-user.target 就到不了**（systemd 会给 target 隐式补上
#   After=，见 systemd.unit(5)「target units will implicitly complement
#   all configured dependencies of type Wants= or Requires= with After=
#   dependencies」）。
#
#   这台机器没有 RJ45，内置 Wi-Fi 是唯一链路；而"接口没出现"在这台机器上
#   并不是异常情况（SDIO 没枚举、驱动没绑上、固件没就位都可能发生）。
#   于是 ExecStartPre 失败 → 单元进入自动重启 → start job 永远不完成 →
#   整机停在 getty.target 之后：没有 multi-user.target、没有 SSH、
#   看起来像砖了。
#
#   ★ 开机即用的底线：**Wi-Fi 失败绝不能挡开机。**
#   所以等待搬到进程里：Type=simple 的 start job 在 fork 之后立刻完成，
#   multi-user.target 随之达成；接口什么时候出现，wpa_supplicant 就在
#   什么时候被拉起来。
#
# 用法：qm1-wifi-start <接口名> [配置文件]
set -u

IFACE="${1:-wlan0}"
CONF="${2:-/etc/wpa_supplicant/wpa_supplicant.conf}"
LOG_TAG=qm1-wifi
# 每隔多久打一条"还在等"的日志（秒）
LOG_EVERY="${QM1_WIFI_LOG_EVERY:-15}"

log() {
    logger -t "$LOG_TAG" -- "$*" 2>/dev/null || true
    printf '%s\n' "$*" >&2 || true
}

# 配置里必须有能连的网络块。出厂配置里的 network 块是**注释掉的**，
# 真正的凭据由 qm1-firstboot 在首启时写进来（从 provisioning 载荷里取）。
#
# 如果配置里一个 network 块都没有，wpa_supplicant 照样能起来、wlan0 照样在、
# SSID 也扫得到 —— 但它什么也不连。现场表现就是"能看见 SSID 就是连不上"，
# 而日志里一句错都没有（最难查的一类）。所以这里显式等，并说清在等什么。
conf_has_network() {
    [ -f "$CONF" ] || return 1
    grep -q '^[[:space:]]*network[[:space:]]*=' "$CONF" 2>/dev/null
}

# "接口没出现"有好几种，得分清楚 —— 它们要修的地方完全不同，日志里必须点名：
#
#   * 模块没加载        ⇒ 装错了 / vermagic 不对 / 模块索引没刷新（modprobe 说找不到）
#   * 加载的是树内 staging ⇒ 隔离没生效（bind 到 r8723bs 而不是出货模块）
#   * 模块在、卡也在，就是没绑上 ⇒ 固件没就位 / 模块没认领这张卡
#   * 模块在、卡不在   ⇒ SDIO 卡压根没枚举出来（内核没认出这块设备）
#
# 统一放在这里判断，日志里带上结论；否则真机上"wlan0 不出现"只会留下一句
# "还在等 wlan0"，看不出到底卡在哪一步。
module_state() {
    for _m in rtw88_qm1 rtw88_8723bs rtw_8723bs; do
        [ -d "/sys/module/$_m" ] && { printf 'loaded:%s' "$_m"; return 0; }
    done
    [ -d /sys/module/r8723bs ] && { printf 'staging:r8723bs'; return 0; }
    printf 'none'
}

sdio_card_present() {
    for _d in /sys/bus/sdio/devices/*; do
        [ -e "$_d" ] || continue
        if grep -qs 'MODALIAS=sdio:c\*v024CdB723\*' "$_d/uevent" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

explain_wait() {
    case "$(module_state)" in
        none)
            printf '驱动模块没加载（/sys/module/ 下没有 rtw88_qm1）—— 这是"装不上/没加载"，不是"接口还没出现"'
            ;;
        staging:*)
            printf '加载的是树内 staging 驱动（r8723bs）—— 隔离没生效，出货模块没抢到这张卡'
            ;;
        loaded:*)
            if sdio_card_present; then
                printf '驱动在、SDIO 卡也在，就是没绑上（固件没就位或模块没认领这张卡）'
            else
                printf '驱动在，但 SDIO 卡没枚举出来（内核没认出这块 SDIO 设备）'
            fi
            ;;
    esac
}

waited=0
# 兜底：万一内核/驱动给的不是 wlan0（接口名取决于内核与驱动），就退而求其次
# 找任何一个带 /wireless 的接口。这台机器没有网口，Wi-Fi 断了就是整机断网，
# 宁可名字对不上，也不能不把 wpa_supplicant 拉起来。
find_wireless_iface() {
    for _d in /sys/class/net/*; do
        [ -e "$_d/wireless" ] || continue
        printf '%s' "${_d##*/}"
        return 0
    done
    return 1
}

while ! ip link show "$IFACE" >/dev/null 2>&1; do
    _alt="$(find_wireless_iface || true)"
    if [ -n "$_alt" ]; then
        log "接口名不是 $IFACE，改用内核实际给出的无线接口 $_alt"
        IFACE="$_alt"
        break
    fi
    if [ $((waited % LOG_EVERY)) -eq 0 ]; then
        log "还在等 $IFACE 出现（已等 ${waited}s）：$(explain_wait)"
    fi
    waited=$((waited + 1))
    sleep 1
done

log "$IFACE 已出现"

# 等一份"能连"的配置
while ! conf_has_network; do
    if [ ! -f "$CONF" ]; then
        _why="还没有 $CONF（首启脚本会写它）"
    else
        _why="$CONF 里没有 network 块 —— 没有可连的 Wi-Fi（首启脚本会写凭据进来）"
    fi
    if [ $((waited % LOG_EVERY)) -eq 0 ]; then
        log "等一份能连的配置：$_why"
    fi
    waited=$((waited + 1))
    sleep 1
done

log "$IFACE 已出现且配置里有网络块，启动 wpa_supplicant（配置 $CONF）"
# exec：让 wpa_supplicant 接管这个进程，systemd 就能看着它、
# 它退出时也能被 Restart= 正常拉起。
exec /usr/sbin/wpa_supplicant -i "$IFACE" -c "$CONF"
