#!/bin/bash
# qm1-firstboot — 首次开机时读取 provisioning 文件，自动完成 Wi-Fi / SSH / 主机名配置
#
# 目的：这台机器没有 RJ45，唯一联网链路是内置 Wi-Fi（RTL8723BS）。
#       如果每次装完系统还要"插显示器 + 键盘 + 手动敲 wpa_supplicant"，
#       装机就变成一件很麻烦的事。所以照 Raspberry Pi 的做法：
#       把配置文件放进**启动分区**，系统开机自己读。
#
# provisioning 文件来源（按顺序）：
#   1) /etc/qm1/provision/       —— 安装时随根文件系统一起写入（最可靠）
#   2) ESP 上的 /qm1/provision/  —— 引导分区里的文件（可直接往 U 盘/卡里放，
#                                  不重刷镜像也能改）
#
# 认得的文件：
#   wpa_supplicant.conf   Wi-Fi 配置；存在即写入系统并启用 qm1-wifi@wlan0
#   ssh                   存在即启用 SSH 服务（内容随意，通常为空）
#   authorized_keys       可选：SSH 公钥（装到 ssh 用户与 root）
#   hostname              可选：主机名
#
# 幂等：成功后写标记 /var/lib/qm1/firstboot-done，再次运行会跳过。
#       加 --force 可强制重跑（会先清掉标记）。
set -euo pipefail

PROV_DIR="/etc/qm1/provision"
MARKER="/var/lib/qm1/firstboot-done"
ESP_MOUNT="/run/qm1/firstboot-esp"
ESP_OWN_MOUNT=0
# EFI System partition type, restricted below to the running root disk.
ESP_PARTTYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"

FORCE=0
for _arg in "$@"; do
    case "$_arg" in
        --force) FORCE=1 ;;
        *) echo "用法：qm1-firstboot [--force]" >&2; exit 2 ;;
    esac
done

log()  { printf '[qm1-firstboot] %s\n' "$*"; }
warn() { printf '[qm1-firstboot][warn] %s\n' "$*" >&2; }

# 启动分区是临时挂来读 provisioning 的 —— 读完必须卸掉：
# 留着会让 /run 下的挂载点一直占着，而且 --force 重跑时挂载会失败。
cleanup() {
    if [ "$ESP_OWN_MOUNT" = 1 ] && mountpoint -q "$ESP_MOUNT" 2>/dev/null; then
        umount "$ESP_MOUNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

[ "$(id -u)" -eq 0 ] || { echo "需要 root 权限" >&2; exit 1; }

if [ "$FORCE" = 1 ]; then
    rm -f "$MARKER"
    log "--force：已清掉标记 ${MARKER}，强制重跑"
elif [ -f "$MARKER" ]; then
    log "已完成过首启配置（${MARKER}），跳过"
    log "要重跑：sudo qm1-firstboot --force"
    exit 0
fi

# ---------- 1. 找到 provisioning 目录 ----------
SRC=""
if [ -d "$PROV_DIR" ] && [ -n "$(ls -A "$PROV_DIR" 2>/dev/null || true)" ]; then
    SRC="$PROV_DIR"
    log "使用根文件系统内的配置：$SRC"
else
    # Only inspect the disk backing this running root filesystem. A global
    # label/type search can pick the old Void ESP while booted from USB.
    root_dev="$(findmnt -nro SOURCE / 2>/dev/null || true)"
    root_dev="$(readlink -f "$root_dev" 2>/dev/null || true)"
    root_disk=""
    if [ -n "$root_dev" ]; then
        root_disk="$(lsblk -npro PKNAME "$root_dev" 2>/dev/null || true)"
    fi
    # The rootfs-only QEMU smoke test boots an unpartitioned filesystem.
    # It has no sibling ESP; do not fall back to any other attached disk.
    if [ -n "$root_dev" ] && [ -z "$root_disk" ] \
        && [ "$(lsblk -dnro TYPE "$root_dev" 2>/dev/null || true)" = disk ]; then
        log "根文件系统直接位于整盘，无独立 ESP；没有发现 provisioning 文件"
        exit 0
    fi
    case "$root_disk" in
        /dev/*) ;;
        *) warn "无法确定当前根分区所在磁盘，不读取其他磁盘的配置"; exit 1 ;;
    esac
    log "根分区：${root_dev}，根磁盘：$root_disk"
    # Read GPT entry types from disk, not the udev database: early boot can
    # expose the block devices before udev has populated PARTTYPE/LABEL.
    esp_candidates=""
    while IFS= read -r part_dev; do
        [ -n "$part_dev" ] || continue
        part_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$part_dev" 2>/dev/null || true)"
        if [ "$part_type" = "$ESP_PARTTYPE" ]; then
            esp_candidates="${esp_candidates}${part_dev}
"
        fi
    done < <(lsblk -nrpo PATH,TYPE "$root_disk" 2>/dev/null | awk '$2=="part"{print $1}')
    esp_candidates="$(printf '%s' "$esp_candidates" | awk 'NF{print}')"
    esp_count="$(printf '%s\n' "$esp_candidates" | awk 'NF{n++} END{print n+0}')"
    if [ "$esp_count" -ne 1 ]; then
        warn "根磁盘 $root_disk 上需要唯一的 EFI 分区，实际为 ${esp_count}；首启配置未完成"
        exit 1
    fi
    esp_dev="$esp_candidates"
    log "同盘 ESP：$esp_dev"
    # fstab normally mounted this ESP at /boot/efi already. Re-mounting the
    # same FAT superblock read-only fails with "would change RO state".
    # Reuse only a mount whose SOURCE is our root disk's ESP.
    esp_read_path="$(findmnt -fnro TARGET --source "$esp_dev" 2>/dev/null || true)"
    if [ -z "$esp_read_path" ]; then
        mkdir -p "$ESP_MOUNT"
        if mount_error="$(mount -o ro "$esp_dev" "$ESP_MOUNT" 2>&1)"; then
            ESP_OWN_MOUNT=1
            esp_read_path="$ESP_MOUNT"
        else
            # The fstab mount may have completed since the first lookup.
            esp_read_path="$(findmnt -fnro TARGET --source "$esp_dev" 2>/dev/null || true)"
            if [ -z "$esp_read_path" ]; then
                warn "挂载启动分区 $esp_dev 失败：$mount_error"
                exit 1
            fi
        fi
    fi
    if [ -d "$esp_read_path/qm1/provision" ]; then
        SRC="$esp_read_path/qm1/provision"
        log "使用启动分区内的配置：$SRC"
    else
        log "当前根磁盘 ESP 没有 /qm1/provision；没有私有首启配置"
    fi
fi

if [ -z "$SRC" ]; then
    log "没有发现 provisioning 文件 —— 跳过自动配置（下次开机还会再找一次）"
    log "  之后可以这样配："
    log "    sudo nano /etc/wpa_supplicant/wpa_supplicant.conf   # 填 SSID/PSK"
    log "    sudo systemctl enable --now qm1-wifi@wlan0"
    log "    sudo systemctl enable --now ssh"
    log "  （这台机器用 systemd-networkd + wpa_supplicant，没有 NetworkManager，nmcli 用不了）"
    exit 0
fi

CHANGED=0

# ---------- 2. Wi-Fi ----------
if [ -f "$SRC/wpa_supplicant.conf" ]; then
    install -d -m 0755 /etc/wpa_supplicant
    install -m 0600 "$SRC/wpa_supplicant.conf" /etc/wpa_supplicant/wpa_supplicant.conf
    log "已写入 Wi-Fi 配置：/etc/wpa_supplicant/wpa_supplicant.conf"
    systemctl enable qm1-wifi@wlan0 >/dev/null 2>&1 \
        || ln -sf /etc/systemd/system/qm1-wifi@.service \
               /etc/systemd/system/multi-user.target.wants/qm1-wifi@wlan0.service
    # 链接必须不是悬空的（单元就在 /etc/systemd/system）
    if [ ! -e /etc/systemd/system/multi-user.target.wants/qm1-wifi@wlan0.service ]; then
        warn "qm1-wifi@wlan0 的 wants 链接是悬空的，Wi-Fi 不会自动启动"
    fi
    # --no-block 是必须的：本单元 (qm1-firstboot.service) 排在这个单元**之后**
    # （qm1-wifi@.service 有 After=qm1-firstboot.service），所以在首启脚本里
    # 直接 `systemctl restart` 会互相等待 —— 首启脚本等 wifi 重启完成，
    # 而 wifi 的启动作业又排在首启脚本结束之后 ⇒ 自死锁。
    systemctl restart --no-block qm1-wifi@wlan0 >/dev/null 2>&1 \
        || warn "Wi-Fi 服务重启失败（接口可能还没出现，稍后会自动重试）"
    CHANGED=1
else
    log "没有 wpa_supplicant.conf —— 不动 Wi-Fi 配置"
fi

# ---------- 3. SSH ----------
if [ -f "$SRC/ssh" ]; then
    if systemctl enable ssh >/dev/null 2>&1; then
        log "已启用 SSH 服务"
    else
        warn "启用 SSH 失败（可能没装 openssh-server）"
    fi
    CHANGED=1
else
    log "没有 ssh 标记文件 —— 不启用 SSH"
fi

# ---------- 4. SSH 公钥 ----------
if [ -f "$SRC/authorized_keys" ]; then
    KEYFILE="/root/.ssh/authorized_keys"
    install -d -m 0700 /root/.ssh
    touch "$KEYFILE"
    chmod 0600 "$KEYFILE"
    # 空文件不能算"已经装过了"：grep -f 拿空行当模式会匹配任何一行，
    # 结果是公钥永远装不上去。这里先数一下真正的公钥行。
    KEY_COUNT="$(grep -cve '^[[:space:]]*$' "$SRC/authorized_keys" 2>/dev/null || true)"
    if [ "${KEY_COUNT:-0}" -eq 0 ]; then
        warn "authorized_keys 为空，首启配置未完成"; exit 1
    else
        if ! grep -qFf "$SRC/authorized_keys" "$KEYFILE" 2>/dev/null; then
            cat "$SRC/authorized_keys" >> "$KEYFILE"
            log "已把公钥写入 $KEYFILE"
        else
            log "公钥已在 $KEYFILE 里，跳过"
        fi
        SSH_USER=""
        if [ -f "$SRC/ssh_user" ]; then
            SSH_USER="$(tr -d '[:space:]' < "$SRC/ssh_user")"
        fi
        # 没指定就落到镜像里那个能登录的普通账号 qm1 ——
        # sshd 明确禁掉了 root 登录（sshd_config.d/qm1.conf: PermitRootLogin no），
        # 公钥只装到 /root/.ssh 的话，谁也登不进来（"装完了但连不上"的经典原因）。
        if [ -z "$SSH_USER" ]; then
            if id qm1 >/dev/null 2>&1; then
                SSH_USER=qm1
                log "provision 里没写 ssh_user —— 公钥改装到默认登录账号 qm1"
            else
                warn "默认 qm1 用户不存在，首启配置未完成"; exit 1
            fi
        fi
        if [ -n "$SSH_USER" ] && id "$SSH_USER" >/dev/null 2>&1; then
            UHOME="$(getent passwd "$SSH_USER" | cut -d: -f6)"
            [ -n "$UHOME" ] || UHOME="/home/$SSH_USER"
            install -d -m 0700 "$UHOME/.ssh"
            touch "$UHOME/.ssh/authorized_keys"
            chmod 0600 "$UHOME/.ssh/authorized_keys"
            if ! grep -qFf "$SRC/authorized_keys" "$UHOME/.ssh/authorized_keys" 2>/dev/null; then
                cat "$SRC/authorized_keys" >> "$UHOME/.ssh/authorized_keys"
                log "已把公钥写入 $UHOME/.ssh/authorized_keys（用户 ${SSH_USER}）"
            fi
            chown "$SSH_USER:" "$UHOME/.ssh" "$UHOME/.ssh/authorized_keys"
        elif [ -n "$SSH_USER" ]; then
            warn "ssh_user 指定的用户 $SSH_USER 不存在，首启配置未完成"; exit 1
        fi
    fi
    CHANGED=1
fi

# Optional private SHA512-crypt hash: enables the user's local password/sudo,
# without distributing a universal password or enabling SSH password auth.
if [ -f "$SRC/ssh_password_hash" ]; then
    LOGIN_USER=qm1
    [ ! -f "$SRC/ssh_user" ] || LOGIN_USER="$(tr -d '[:space:]' < "$SRC/ssh_user")"
    id "$LOGIN_USER" >/dev/null 2>&1 || { warn "password target user is absent"; exit 1; }
    PASSWORD_HASH="$(cat "$SRC/ssh_password_hash")"
    HASH_PATTERN='^\$6\$(rounds=[0-9]+\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}$'
    [[ "$PASSWORD_HASH" =~ $HASH_PATTERN ]] || { warn "invalid SHA512-crypt hash"; exit 1; }
    printf '%s:%s\n' "$LOGIN_USER" "$PASSWORD_HASH" | chpasswd --encrypted
    unset PASSWORD_HASH
    CHANGED=1
    log "已配置 ${LOGIN_USER} 的本地密码（未启用 SSH 密码认证）"
fi

# ---------- 5. 主机名 ----------
if [ -f "$SRC/hostname" ]; then
    HN="$(tr -d '[:space:]' < "$SRC/hostname")"
    if [ -n "$HN" ]; then
        hostnamectl set-hostname "$HN" 2>/dev/null || echo "$HN" > /etc/hostname
        log "已设置主机名：$HN"
        CHANGED=1
    fi
fi

# ---------- 6. 收尾 ----------
# 只有真的改了东西才写标记 —— 否则"配置存在但还没生效"（比如只放了
# authorized_keys、Wi-Fi 还没关联上）会被永久记住，再也不会重试。
if [ "$CHANGED" = 1 ]; then
    mkdir -p "$(dirname "$MARKER")"
    {
        echo "applied_at=$(date -Is)"
        echo "source=$SRC"
        echo "changed=$CHANGED"
    } > "$MARKER"
    log "首启配置完成（标记：${MARKER}）"
else
    log "provisioning 目录里没有可应用的项目 —— 不写标记，下次开机继续检查"
fi

if [ "$CHANGED" = 1 ]; then
    log "提示：Wi-Fi 关联可能需要几十秒，可用 'ip addr' / 'iw dev wlan0 link' 查看"
fi
exit 0
