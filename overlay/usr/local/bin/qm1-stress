#!/bin/sh
# ============================================================================
# qm1-stress — 稳定性复现脚本（把"不稳定"变成可重复的用例）
#
# 用法：
#   qm1-stress --idle-io [轮数]   S1：每轮「空闲 30s → 顺序读写 64MB」。
#                                 深 C-state + DMA 冲突的经典触发条件就是
#                                 「长时间空闲后第一次 IO」。
#   qm1-stress --fio [分钟]        S2：fio 顺序/随机读写，命中 eMMC 的
#                                 reset/timeout 路径。
#   qm1-stress --wifi [分钟]       S3：iperf3 上行 + 周期采样链路与丢包。
#   qm1-stress --all               依次跑上面三项（推荐给真机长测）。
#
# 所有输出写入 /var/log/qm1-health/stress-<时间戳>.log，
# 同时 qm1-health-collect 的快照里能看到同期的系统指标。
#
# 注意：本脚本会写满介质（fio 写 eMMC），跑完请删掉测试文件；
#      别在已经装了重要数据的盘上长时间跑 --fio。
# ============================================================================
set -u

LOGDIR="${QM1_HEALTH_DIR:-/var/log/qm1-health}"
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$LOGDIR/stress-$STAMP.log"
TESTDIR="${QM1_STRESS_DIR:-/var/tmp/qm1-stress}"

mkdir -p "$LOGDIR" "$TESTDIR" || exit 1

log() { printf '%s %s\n' "$(date -Is 2>/dev/null || date)" "$*" | tee -a "$LOG"; }

run_health() { /usr/local/sbin/qm1-health-collect >/dev/null 2>&1 || true; }

# ---------------- S1：空闲 → IO ----------------
idle_io() {
    rounds="${1:-50}"
    log "=== S1 空闲→IO 压测：$rounds 轮（每轮空闲 30s 后写 64MB）==="
    i=1
    while [ "$i" -le "$rounds" ]; do
        log "[S1] 第 $i/$rounds 轮：进入空闲（30s）"
        sleep 30
        dd if=/dev/zero of="$TESTDIR/idle-io.bin" bs=1M count=64 conv=fsync 2>&1 | tail -1 | tee -a "$LOG"
        sync
        rm -f "$TESTDIR/idle-io.bin"
        log "[S1] 第 $i 轮完成"
        run_health
        i=$((i + 1))
    done
    log "=== S1 完成：$rounds 轮。请检查 dmesg 是否出现 hung task / I/O error ==="
}

# ---------------- S2：fio 压测 ----------------
fio_run() {
    minutes="${1:-30}"
    log "=== S2 eMMC 压测：$minutes 分钟（顺序写 + 随机 4k）==="
    if ! command -v fio >/dev/null 2>&1; then
        log "S2 跳过：未安装 fio（apt install fio）"
        return 0
    fi
    timeout "${minutes}m" fio --name=seqwrite --filename="$TESTDIR/fio-seq.bin" --bs=1M \
        --size=256M --rw=write --direct=1 --iodepth=1 --output-format=normal 2>&1 | tail -20 | tee -a "$LOG"
    rm -f "$TESTDIR/fio-seq.bin"
    timeout "${minutes}m" fio --name=randread --filename="$TESTDIR/fio-rand.bin" --bs=4k \
        --size=128M --rw=randread --direct=1 --iodepth=4 --output-format=normal 2>&1 | tail -20 | tee -a "$LOG"
    rm -f "$TESTDIR/fio-rand.bin"
    run_health
    log "=== S2 完成。请检查 dmesg 是否出现 'Reset 0x1 never completed' / I/O error ==="
}

# ---------------- S3：Wi-Fi 吞吐 ----------------
wifi_run() {
    minutes="${1:-30}"
    log "=== S3 Wi-Fi 吞吐压测：$minutes 分钟 ==="
    if ! command -v iperf3 >/dev/null 2>&1; then
        log "S3 跳过：未安装 iperf3（apt install iperf3）"
    else
        target="${QM1_IPERF_TARGET:-}"
        if [ -z "$target" ]; then
            log "S3 跳过：未设置 QM1_IPERF_TARGET（局域网内另一台机器的地址）"
        else
            timeout "${minutes}m" iperf3 -c "$target" -t "${minutes}" 2>&1 | tail -30 | tee -a "$LOG"
        fi
    fi
    i=1
    while [ "$i" -le "$minutes" ]; do
        if command -v iw >/dev/null 2>&1; then
            iw dev wlan0 link 2>&1 | sed 's/^/  /' | tee -a "$LOG"
        fi
        ip -s link show wlan0 2>&1 | sed 's/^/  /' | tee -a "$LOG"
        sleep 60
        run_health
        i=$((i + 1))
    done
    log "=== S3 完成。请检查快照里的 rx_dropped 是否持续增长、链路速率是否塌陷 ==="
}

case "${1:---help}" in
    --idle-io) idle_io "${2:-50}" ;;
    --fio)     fio_run "${2:-30}" ;;
    --wifi)    wifi_run "${2:-30}" ;;
    --all)     idle_io "${2:-50}"; fio_run "${3:-30}"; wifi_run "${4:-30}" ;;
    --help|-h)
        sed -n '2,25p' "$0" | sed 's/^# \?//'
        ;;
    *)
        echo "用法: qm1-stress --idle-io [轮数] | --fio [分钟] | --wifi [分钟] | --all" >&2
        exit 2
        ;;
esac
log "日志：$LOG"
exit 0
