[Unit]
Description=QM1 runtime provisioning (Hermes CLI + headless Chrome)
Documentation=file:///usr/local/share/qm1/README-runtime.txt
# 等网络真的可用：内置 Wi-Fi 是这台机器唯一的联网链路，
# networkd 的 30-wifi.network 标了 RequiredForOnline=yes ⇒ network-online.target
# 只有在 wlan0 拿到地址之后才达成。
#
# ★ 这个单元**不挂在 multi-user.target 上**，而是由 qm1-provision.timer 触发。
#   原因有两个，都是真机级别的问题：
#
#   1) target 会给 Wants=/Requires= 的成员隐式补 After=
#      （systemd.unit(5)：target units will implicitly complement all configured
#      dependencies of type Wants= or Requires= with After= dependencies）。
#      所以只要本单元被 multi-user.target 拉起来，而本单元又要等
#      network-online.target，就等于"整机开机必须等到网络就绪"——
#      这台机器没有 RJ45，内置 Wi-Fi 是唯一链路，Wi-Fi 没起来时
#      整机到不了 multi-user.target ⇒ 没有 SSH、看起来像砖了。
#
#   2) 本单元自己是 After=multi-user.target，而它又被 multi-user.target
#      拉 ⇒ 隐式 After= 与显式 After= 构成**排序环**，systemd 只能
#      任意断掉一条边，结果不可预期（表现为开机卡住或单元被跳过）。
#
#   所以：timer 负责"什么时候开始铺"，本单元只管"网络就绪后再铺"。
After=network-online.target
Wants=network-online.target
# 没有 agent 脚本（裁剪过的镜像）就什么都不做；已经铺好就不重复铺。
ConditionPathExists=/usr/local/share/qm1/provision-agent.sh
ConditionPathExists=!/var/lib/qm1/provision-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/qm1-provision
# 装 Hermes 要下载官方安装器、uv 托管的 Python 3.14、Node 运行时 —— 慢是正常的。
TimeoutStartSec=3600
#
# ★ 失败要真的重试，而且要十分钟后再来。
#
#   原来靠 timer 的 OnUnitInactiveSec=10min 来重试 —— 那是不成立的：
#   OnUnitInactiveSec 要的是单元"变成 inactive"，而失败的 oneshot 落到的是
#   **failed**，不是 inactive ⇒ 定时器永远不会因为失败而再次触发
#   ⇒ 铺运行时失败一次，就不会再试（只能等下次开机）。
#   （成功的单元停在 active (exited)，同样不是 inactive ⇒ 那条定时器
#     在成功路径上也是空转。）
#
#   所以重试由本单元自己承担：Restart=on-failure 是 Type=oneshot 允许的
#   （只有 always / on-success 不允许），失败后 systemd 会重新拉起它。
#   RestartSec=600 就是"十分钟后再来一次"。
Restart=on-failure
RestartSec=600
# 一小时里最多试 6 次；超过就停手（start request repeated too quickly），
# 下次开机还会从头再来 —— 不做无休止的重试风暴。
StartLimitIntervalSec=3600
StartLimitBurst=6
