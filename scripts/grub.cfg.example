# grub.cfg 模板 —— 部署到 FAT32 ESP 的 /EFI/BOOT/grub.cfg
#
# 占位符由 make-esp.sh 替换：
#   @ROOT_UUID@     64 位根分区 UUID（ext4）
#   @ROOT32_UUID@  32 位根分区 UUID（ext4）；没有 32 位系统时整段菜单项会被删除
#   @SUITE_AMD64@  64 位系统发行版名（如 Debian 13）
#   @SUITE_I386@   32 位系统发行版名（如 Debian 12）
#
# 定位说明：
#   search --label @ESP_LABEL@ --set=root  找到引导分区本身（内核与 initrd 放在 ESP 上）
#   root=UUID=...                     找到根文件系统分区
#   两个 UUID 不同源：前者是 FAT32 ESP 卷标，后者是 ext4 根分区 UUID。
#
# @ESP_LABEL@ 由 make-esp.sh 替换成实际建卷时的 FAT32 卷标（默认 QM1ESP）。
# 卷标写错 = GRUB 找不到引导分区 = 机器起不来，所以 make-esp.sh 会核对
# 生成的 search 行与实际卷标是否一致。
#
# 内核参数说明：
#   console=ttyS0,115200n8  串口控制台 —— 头显上没画面时的唯一救援通道（务必保留）
#   fsck.repair=yes         eMMC 突然掉电后开机自修复
#   ro                      根以只读挂载，交给 systemd 之后 remount-rw
#   intel_idle.max_cstate=1 把最深 C-state 限制在 C1。Z3735F 在 Bay Trail 的 C-state
#                           冻结 bug 受影响名单内（Ubuntu Launchpad #1471989 的 Z3735F
#                           机器 -110 实证、AskUbuntu 803640、watchmysys 实测博客），
#                           而「深 C-state + SDIO/eMMC 的 DMA 冲突」是同一个旋钮。
#                           本机无电池、5V/2A 常供电、不以省电为目标，锁到 C1 只损失
#                           一点功耗，换来的是不随机冻死（挂死时只能拔电源）。

set timeout=5
set default=0

search --label @ESP_LABEL@ --set=root

# 64 位系统（amd64）：由 IA32 引导器经 EFI handover 加载
# 发行版名用占位符：Debian 13 起不再提供 i386 内核，32 位系统请用 Debian 12（bookworm），
# 两边的菜单标题要如实写清楚是哪一版。
menuentry "QM1 @SUITE_AMD64@ (64-bit amd64)" {
    linux  /vmlinuz    root=UUID=@ROOT_UUID@ ro console=tty0 console=ttyS0,115200n8 fsck.repair=yes intel_idle.max_cstate=1
    initrd /initrd.img
}

# 32 位系统（i386）：32 位固件可直接加载，i386-efi 引导器亦可
# 文件名用 8.3 可精确表示的形式（vmlinuz32 / initrd32.img），
# 这样即使 ESP 卷没有长文件名表（LFN）也能被 GRUB 找到。
menuentry "QM1 @SUITE_I386@ (32-bit i386)" {
    linux  /vmlinuz32 root=UUID=@ROOT32_UUID@ ro console=tty0 console=ttyS0,115200n8 fsck.repair=yes intel_idle.max_cstate=1
    initrd /initrd32.img
}
